page {
  background-color: #fafaf8;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.notice {
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 12rpx;
  padding: 20rpx;
  color: #134e4a;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.btn {
  background: #0f766e;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.title { font-size: 32rpx; font-weight: 600; }
.description { margin: 8rpx 0; }
.secondary { background: #fff; color: #0f766e; border: 1rpx solid #0f766e; }
.actions, .pagination { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 0; }
.actions > button, .actions > picker, .actions > input, .pagination > button { flex: 1; }
.filter { display: block; padding: 16rpx; background: white; border: 1rpx solid #e5e7eb; border-radius: 12rpx; }
.field { min-width: 0; background: white; border-radius: 12rpx; border: 1rpx solid #e5e7eb; padding: 12rpx 16rpx; }
.article-body { display: block; white-space: pre-wrap; overflow-wrap: anywhere; }

.home-intro { background: #f0fdfa; border-color: #cdebe4; padding: 32rpx 24rpx; }
.home-intro .title { font-size: 38rpx; }
.brand-header { display: flex; align-items: center; gap: 20rpx; margin-bottom: 16rpx; }
.brand-logo { width: 96rpx; height: 96rpx; border-radius: 20rpx; flex-shrink: 0; border: 1rpx solid #ccfbf1; }
.brand-meta { flex: 1; min-width: 0; }
