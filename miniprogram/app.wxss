page {
  background-color: #fafaf8;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.notice {
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 12rpx;
  padding: 20rpx;
  color: #134e4a;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.btn {
  background: #0f766e;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
