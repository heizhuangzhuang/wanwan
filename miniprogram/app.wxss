page {
  background-color: #fbf7f0;
  color: #2b302a;
  font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

.container { max-width: 840rpx; margin: 0 auto; padding: 32rpx 28rpx 64rpx; box-sizing: border-box; }
.card { background: #fffdf9; border: 1px solid #e7ddd2; border-radius: 24rpx; padding: 24rpx; margin: 0 0 16rpx; overflow-wrap: anywhere; }
.notice, .reading-state { background: #f4ece1; border-radius: 16rpx; padding: 24rpx; color: #4c4b40; margin: 16rpx 0; font-size: 27rpx; }
.muted { color: #595f54; font-size: 26rpx; }
.title { font-size: 32rpx; font-weight: 600; }
.description { margin: 8rpx 0; overflow-wrap: anywhere; font-size: 29rpx; }
.btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; background: #376052; color: #fffdf9; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; line-height: 1.35; min-height: 88rpx; }
button.btn:not([size='mini']) { width: 100%; max-width: none; margin: 0; padding: 0 24rpx; }
.btn::after, .plain-button::after, .feature-link::after, .resource-card::after, .term::after { border: 0; }
.btn.secondary { background: #fffdf9; color: #376052; border: 1px solid #b4c4b4; }
.btn[disabled], .term[disabled] { background: #efe9df; color: #6b685d; }
.btn.compact, button.btn.compact:not([size='mini']) { display: inline-flex; width: auto; max-width: none; margin: 0 0 0 16rpx; padding: 0 24rpx; min-height: 72rpx; line-height: 1.3; font-size: 27rpx; }
.actions, .pagination { display: flex; align-items: center; gap: 16rpx; margin: 16rpx 0 24rpx; }
.actions > button, .actions > picker, .actions > input, .pagination > button { flex: 1; min-width: 0; margin: 0; }
.actions > .btn, .pagination > .btn { padding: 0 12rpx; }
.filter, .field { display: block; box-sizing: border-box; background: #fffdf9; border: 1px solid #d9cdbf; border-radius: 16rpx; padding: 16rpx; min-height: 88rpx; }
.field { min-width: 0; }
.pressed { opacity: .76; }

.page-heading { font-family: "Songti SC", "Noto Serif CJK SC", serif; font-size: 46rpx; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
.search-entry { display: flex; align-items: center; min-height: 96rpx; gap: 16rpx; margin: 24rpx 0 16rpx; border: 1px solid #ddcfc1; border-radius: 24rpx; background: #fffdf9; padding: 0 24rpx; font-size: 27rpx; }
.search-mark { width: 24rpx; height: 24rpx; border: 3rpx solid #376052; border-radius: 50%; position: relative; margin-right: 6rpx; flex-shrink: 0; }
.search-mark::after { content: ""; width: 12rpx; height: 3rpx; position: absolute; background: #376052; right: -9rpx; bottom: -4rpx; transform: rotate(45deg); }
.search-action { margin-left: auto; color: #376052; font-weight: 600; white-space: nowrap; }
.section-heading { font-size: 34rpx; font-weight: 700; margin: 32rpx 0 16rpx; }
.section-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 32rpx; }
.section-bar .section-heading { margin: 0 0 16rpx; }
.text-link, .site-footer { color: #365a4c; text-decoration: underline; font-size: 26rpx; padding: 12rpx 0; }
.site-footer { display: block; text-align: center; margin-top: 24rpx; }
.feature-link, .resource-card, .plain-button { display: block; width: 100%; box-sizing: border-box; text-align: left; color: #2b302a; line-height: 1.6; }
.chevron { color: #376052; font-size: 42rpx; line-height: 1; }
.feature-link { background: #f4ece1; margin-bottom: 16rpx; border-radius: 20rpx; padding: 24rpx; font-size: 27rpx; overflow-wrap: anywhere; }
.guide-link { display: flex; align-items: center; justify-content: space-between; min-height: 80rpx; color: #376052; padding: 0 16rpx; font-size: 28rpx; }
.page-intro { padding: 16rpx 0 24rpx; }
.page-intro .description { color: #595f54; }
.resource-card { border-left: 5rpx solid #a9baa7; }
button.resource-card { width: 100%; max-width: none; font-weight: 400; }
.resource-meta { display: flex; flex-wrap: wrap; gap: 12rpx; font-size: 25rpx; color: #365a4c; margin: 12rpx 0 4rpx; }
.search-suggestions { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin: 24rpx 0; }
.term { margin: 0; border-radius: 32rpx; padding: 0 20rpx; font-size: 26rpx; line-height: 64rpx; background: #e8eee4; color: #365a4c; }
.plain-button { background: transparent; padding: 0; border-radius: 0; }
button.plain-button:not([size='mini']) { width: 100%; max-width: none; margin: 0; padding: 0; font-weight: 400; text-align: left; }
.shelf-remove { color: #365a4c; margin-top: 16rpx; font-size: 26rpx; min-height: 70rpx; text-decoration: underline; }
.question-list { background: #fffdf9; border: 1px solid #e7ddd2; border-radius: 24rpx; padding: 0 24rpx; }
.question-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 0; font-size: 29rpx; }
.question-row + .question-row { border-top: 1px solid #ece2d7; }
.preparation-copy { margin-top: 24rpx; }

.tab-page { padding-bottom: 142rpx; padding-bottom: calc(142rpx + env(safe-area-inset-bottom)); }
.tab-list { background: #fffdf9; border: 1rpx solid #e7ddd2; border-radius: 24rpx; overflow: hidden; }
.tab-row, .tab-feature { display: flex; box-sizing: border-box; align-items: center; gap: 18rpx; color: #2b302a; }
.tab-row { width: 100%; min-height: 92rpx; padding: 20rpx 24rpx; margin: 0; text-align: left; background: transparent; border-radius: 0; }
.tab-list > button.tab-row { width: 100%; max-width: none; font-weight: 400; }
.tab-row::after { border: 0; }
.tab-row + .tab-row { border-top: 1rpx solid #ece3d7; }
.tab-row-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.tab-row-title { color: #27382f; font-size: 31rpx; font-weight: 600; line-height: 1.4; }
.tab-row-caption { margin-top: 5rpx; color: #555c51; font-size: 28rpx; line-height: 1.5; }
.tab-chevron { flex: none; color: #50715e; font-size: 42rpx; line-height: 1; }
.icon-tile {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #e0ede4;
}
.icon-tile image { display: block; width: 32rpx; height: 32rpx; }
.icon-peach { background: #f4e3d2; }
.icon-rose { background: #f3e0de; }
.icon-sage { background: #e0ede4; }
.icon-blue { background: #dfebf0; }
.icon-gold { background: #f3ebd3; }
.tab-feature > .icon-tile { width: 74rpx; height: 74rpx; background: #fffdf9; border-radius: 20rpx; }
.tab-feature > .icon-tile image { width: 42rpx; height: 42rpx; }
.tab-feature { padding: 28rpx 24rpx; border: 1rpx solid #e7ddd2; border-radius: 28rpx; }
.tab-feature-title { color: #27382f; font-family: "Songti SC", "Noto Serif CJK SC", serif; font-size: 37rpx; font-weight: 700; line-height: 1.3; }
.tab-feature-description { margin-top: 9rpx; color: #435347; font-size: 28rpx; line-height: 1.55; }
.tab-retry { display: flex; gap: 12rpx; align-items: center; justify-content: space-between; }
.tab-retry .btn { flex: none; margin: 0; padding: 0 18rpx; }

.motion-press { transition: opacity 110ms ease-out, transform 110ms ease-out; }
.motion-press.pressed { opacity: .82; transform: scale(.985); }
.motion-reveal { animation: content-reveal 200ms ease-out; }

@keyframes content-reveal {
  from { opacity: .65; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .motion-press { transition: none; }
  .motion-press.pressed { transform: none; }
  .motion-reveal { animation: none; }
}

/* --- Scannable Cards, Badges & Modern Navigation --- */
.clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.badge-row { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-bottom: 10rpx; }
.badge { display: inline-flex; align-items: center; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600; line-height: 1.4; }
.badge-sage { background: #e0ede4; color: #265141; }
.badge-blue { background: #dfebf0; color: #234d63; }
.badge-rose { background: #f3e0de; color: #6e3531; }
.badge-gold { background: #f3ebd3; color: #6c4f1d; }
.badge-literature { background: #e8f1f5; color: #1e4b5c; border: 1rpx solid #b8d4df; font-weight: 700; }
.badge-literature-sub { background: #fffdf9; color: #1e4b5c; border: 1rpx solid #b8d4df; }
.badge-outline { background: #f9f5ee; border: 1rpx solid #ddd2c4; color: #595f54; }
.badge-right { margin-left: auto; }

.resource-card { border-left: 6rpx solid #6f947e; padding: 22rpx 24rpx; }
.resource-card-title { font-size: 31rpx; font-weight: 700; line-height: 1.4; color: #1f2e26; }
.resource-card-intro { margin: 8rpx 0 0; font-size: 27rpx; line-height: 1.5; color: #51584e; }
.resource-card-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; font-size: 23rpx; color: #687064; }

.guide-card { border-left: 6rpx solid #376052; background: #fcfaf5; }
.guide-card-literature { border-left-color: #1e4b5c; }
.guide-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.lit-meta-line { margin-top: 8rpx; font-size: 23rpx; color: #1e4b5c; line-height: 1.45; }

.format-legend { display: flex; gap: 14rpx; margin: 18rpx 0 8rpx; }
.format-pill { flex: 1; min-width: 0; background: #fffdf9; border: 1rpx solid #e7ddd2; border-radius: 18rpx; padding: 16rpx 18rpx; }
.format-pill-guide { border-top: 4rpx solid #376052; }
.format-pill-card { border-top: 4rpx solid #c28d38; }
.format-pill-title { font-size: 26rpx; font-weight: 700; color: #24362c; }
.format-pill-desc { margin-top: 4rpx; font-size: 23rpx; line-height: 1.45; color: #5c6358; }

.filter-chips { display: inline-flex; align-items: center; gap: 12rpx; height: 68rpx; padding: 4rpx 2rpx; box-sizing: border-box; }
.filter-chip { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; height: 60rpx; padding: 0 24rpx; border-radius: 999rpx; font-size: 25rpx; font-weight: 500; background: #fffdf9; border: 1rpx solid #dfd4c7; color: #485046; line-height: 1; box-sizing: border-box; white-space: nowrap; }
.filter-chip.active { background: #376052; border-color: #376052; color: #fffdf9; font-weight: 600; }

.sticky-tabs { display: flex; align-items: center; background: #f4ede3; border-radius: 18rpx; padding: 6rpx; margin: 20rpx 0 14rpx; gap: 6rpx; }
.sticky-tab { flex: 1; text-align: center; padding: 14rpx 8rpx; border-radius: 14rpx; font-size: 26rpx; font-weight: 500; color: #535a50; }
.sticky-tab.active { background: #fffdf9; color: #244a3b; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(39, 56, 47, 0.06); }

.bottom-bar-space { padding-bottom: 148rpx; padding-bottom: calc(148rpx + env(safe-area-inset-bottom)); }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255, 253, 249, 0.96); border-top: 1rpx solid #e7ddd2; box-shadow: 0 -6rpx 20rpx rgba(39, 56, 47, 0.06); box-sizing: border-box; }
.bottom-bar-icon-btn,
.bottom-bar > button.bottom-bar-icon-btn:not([size='mini']) { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: none; width: auto; min-width: 96rpx; max-width: none; padding: 8rpx 12rpx; margin: 0; background: transparent; color: #376052; font-size: 22rpx; line-height: 1.3; font-weight: 500; border-radius: 14rpx; box-sizing: border-box; }
.bottom-bar-icon-btn::after { border: 0; }
.bottom-bar-icon-btn image { width: 34rpx; height: 34rpx; margin-bottom: 4rpx; }
.bottom-bar-primary,
.bottom-bar > button.bottom-bar-primary:not([size='mini']) { flex: 1; width: auto; min-width: 0; max-width: none; margin: 0; padding: 0 24rpx; white-space: nowrap; }
