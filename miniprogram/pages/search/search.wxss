.search-keyword { display: flex; flex: 1; align-items: center; gap: 8rpx; min-width: 0; padding: 0 0 0 16rpx; }
.search-keyword-input { flex: 1; min-width: 0; min-height: 86rpx; font-size: 30rpx; }
.search-page .search-clear { flex: none; width: auto; margin: 0; min-height: 86rpx; min-width: 88rpx; padding: 0 12rpx; line-height: 86rpx; color: #376052; font-size: 26rpx; font-weight: 400; text-align: center; }
.search-status { min-height: 56rpx; margin: 20rpx 0 8rpx; overflow-wrap: anywhere; }
.search-prenatal { margin: 0 0 20rpx; }
.search-result-label { margin: 0 0 12rpx; color: #27382f; }
.search-history { margin: 24rpx 0; padding: 22rpx 24rpx; border: 1rpx solid #e7ddd2; border-radius: 24rpx; background: #fffdf9; }
.search-history-header { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.search-history-header .text-link { width: auto; margin: 0; min-height: 56rpx; padding: 0 6rpx; }
.search-history .search-suggestions { margin: 12rpx 0; }
.search-suggestions-label { flex: 0 0 100%; }
.search-page .term { flex: 0 0 auto; width: auto; max-width: 100%; padding: 14rpx 18rpx; line-height: 1.45; white-space: normal; overflow-wrap: anywhere; }
.search-input-row .btn { flex: 0 0 126rpx; width: 126rpx; max-width: 126rpx; line-height: 88rpx; }
