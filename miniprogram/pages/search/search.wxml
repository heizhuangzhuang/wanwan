<import src="../../templates/public.wxml" />
<view class="container">
  <view class="page-intro"><view class="page-heading">找一找关心的资料</view><view class="description">可按题名、来源或关键词查找公开资料。</view></view>
  <view class="actions">
    <input class="field" placeholder="搜索资料题名、出处或关键词" maxlength="100" value="{{keyword}}" disabled="{{loading}}" bindinput="onInput" bindconfirm="doSearch" />
    <button class="btn" disabled="{{loading}}" bindtap="doSearch">搜索</button>
  </view>
  <view class="actions">
    <picker mode="selector" range="{{stages}}" range-key="label" value="{{stageIndex}}" disabled="{{loading || stageError}}" bindchange="onStage"><view class="filter">{{stages[stageIndex].label}} ▾</view></picker>
    <picker mode="selector" range="{{materials}}" range-key="label" value="{{typeIndex}}" disabled="{{loading}}" bindchange="onType"><view class="filter">{{materials[typeIndex].label}} ▾</view></picker>
  </view>
  <view wx:if="{{!submittedKeyword && !error}}" class="search-suggestions">
    <text class="muted">试试这些关键词</text>
    <button wx:for="{{suggestions}}" wx:key="*this" class="term" data-keyword="{{item}}" bindtap="pickKeyword">{{item}}</button>
  </view>
  <view wx:if="{{stageError}}" class="muted" bindtap="loadFilters">阶段列表暂不可用，点击重试。</view>
  <view wx:if="{{loading}}" class="muted">搜索中…</view>
  <view wx:elif="{{error}}" class="card">
    <view>{{error}}</view>
    <button wx:if="{{submittedKeyword}}" class="btn" bindtap="retry">重试</button>
  </view>
  <block wx:elif="{{submittedKeyword}}">
    <view class="muted description">“{{submittedKeyword}}”的搜索结果</view>
    <view wx:if="{{!items.length}}" class="card">
      <view>没有找到匹配资料。可以更换关键词或按阶段查找。</view>
      <button class="btn secondary" bindtap="browseStages">按阶段浏览</button>
    </view>
    <template is="resourceCards" data="{{items}}" />
    <template is="pagination" data="{{page, hasNext, loading}}" />
  </block>
</view>
