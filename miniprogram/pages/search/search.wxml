<view class="container">
  <view style="display: flex; gap: 12rpx; margin-bottom: 24rpx;">
    <input
      style="flex: 1; background: #fff; border: 1rpx solid #e5e7eb; border-radius: 12rpx; padding: 14rpx 20rpx;"
      placeholder="输入关键词..."
      maxlength="100"
      value="{{keyword}}"
      bindinput="onInput"
      bindconfirm="doSearch"
    />
    <button class="btn" bindtap="doSearch">搜索</button>
  </view>

  <view wx:if="{{loading}}" class="muted">搜索中...</view>
  <view wx:elif="{{error}}" class="card">{{error}}</view>
  <view wx:elif="{{searched && !items.length}}" class="card muted">未找到匹配的已公开资料。</view>
  <view wx:else>
    <view wx:for="{{items}}" wx:key="name" class="card" data-name="{{item.name}}" bindtap="openDetail">
      <view style="font-weight: 600; font-size: 30rpx;">{{item.title}}</view>
      <view style="font-size: 26rpx; margin: 8rpx 0;">{{item.intro}}</view>
      <view class="muted">来源：{{item.sourceName}}</view>
    </view>
  </view>
</view>
