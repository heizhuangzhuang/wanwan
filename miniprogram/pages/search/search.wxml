<import src="../../templates/public.wxml" />
<view class="container search-page">
  <view class="page-intro"><view class="page-heading">找一找关心的资料</view><view class="description">可搜题名、来源、检查简称和原创导读。</view></view>
  <view class="actions search-input-row">
    <view class="field search-keyword">
      <input class="search-keyword-input" placeholder="标题、来源或关键词" confirm-type="search"
        maxlength="100" value="{{keyword}}" disabled="{{loading}}" bindinput="onInput" bindconfirm="doSearch" />
      <button wx:if="{{keyword && !loading}}" class="plain-button search-clear" size="mini"
        aria-label="清除当前搜索" bindtap="clearKeyword">清除</button>
    </view>
    <button class="btn motion-press" size="mini" disabled="{{loading}}" bindtap="doSearch"
      hover-class="pressed" hover-start-time="0" hover-stay-time="90">搜索</button>
  </view>
  <view class="actions">
    <picker mode="selector" range="{{stages}}" range-key="label" value="{{stageIndex}}" disabled="{{loading}}" bindchange="onStage"><view class="filter">{{stages[stageIndex].label}} ▾</view></picker>
    <picker mode="selector" range="{{materials}}" range-key="label" value="{{typeIndex}}" disabled="{{loading}}" bindchange="onType"><view class="filter">{{materials[typeIndex].label}} ▾</view></picker>
  </view>
  <view wx:if="{{!submittedKeyword && !loading && history.length}}" class="search-history">
    <view class="search-history-header">
      <view class="title">最近搜索</view>
      <button class="plain-button text-link" size="mini" bindtap="confirmClearHistory">清空</button>
    </view>
    <view class="search-suggestions">
      <button wx:for="{{history}}" wx:key="*this" class="term" size="mini" data-keyword="{{item}}" bindtap="pickKeyword">{{item}}</button>
    </view>
    <view class="muted">仅保存在本机</view>
  </view>
  <view wx:if="{{!submittedKeyword && !error}}" class="search-suggestions">
    <text class="muted search-suggestions-label">推荐关键词</text>
    <button wx:for="{{suggestions}}" wx:key="*this" class="term" size="mini" data-keyword="{{item}}" bindtap="pickKeyword">{{item}}</button>
  </view>
  <view wx:if="{{submittedKeyword}}" class="search-status title">“{{submittedKeyword}}”的搜索结果</view>
  <view wx:if="{{prenatalResults.length}}" class="search-prenatal motion-reveal">
    <view class="title search-result-label">产前检查导读</view>
    <view class="tab-list">
      <navigator wx:for="{{prenatalResults}}" wx:key="key" class="tab-row motion-press"
        url="/pages/prenatal/prenatal?key={{item.key}}" hover-class="pressed" hover-start-time="0" hover-stay-time="90">
        <view class="tab-row-copy">
          <view class="tab-row-title">{{item.title}}</view>
          <view class="tab-row-caption">{{item.caption}}</view>
        </view>
        <text class="tab-chevron" aria-hidden="true">›</text>
      </navigator>
    </view>
  </view>
  <view wx:if="{{loading}}" class="search-status muted">正在查找公开资料…</view>
  <view wx:elif="{{error}}" class="card">
    <view>{{error}}</view>
    <button wx:if="{{submittedKeyword}}" class="btn" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{submittedKeyword}}" class="motion-reveal">
    <view wx:if="{{items.length}}" class="title search-result-label">公开资料卡</view>
    <view wx:elif="{{prenatalResults.length || guideItems.length}}" class="muted">没有匹配的公开资料卡。</view>
    <view wx:else class="card">
      <view>没有找到匹配内容。可以换个关键词、放宽筛选，或按阶段查找。</view>
      <button class="btn secondary" bindtap="browseStages">按阶段浏览</button>
    </view>
    <template is="resourceCards" data="{{items}}" />
    <view wx:if="{{guideItems.length}}" class="search-prenatal">
      <view class="title search-result-label">本站原创导读</view>
      <view class="tab-list">
        <view wx:for="{{guideItems}}" wx:key="name" class="tab-row motion-press"
          data-name="{{item.name}}" bindtap="openGuide" hover-class="pressed" aria-role="link">
          <view class="tab-row-copy">
            <view class="tab-row-title">{{item.title}}</view>
            <view wx:if="{{item.excerpt}}" class="tab-row-caption">{{item.excerpt}}</view>
          </view>
          <text class="tab-chevron" aria-hidden="true">›</text>
        </view>
      </view>
    </view>
    <template is="pagination" data="{{page, hasNext, loading}}" />
  </view>
</view>
