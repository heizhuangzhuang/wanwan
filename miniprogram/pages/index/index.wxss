.home-welcome { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; background: #e2eee5; border: 1rpx solid #d0e3d6; border-radius: 28rpx; }
.home-welcome-copy { flex: 1; min-width: 0; }
.home-welcome .page-heading { color: #244a3b; font-size: 44rpx; }
.home-welcome .description { margin: 12rpx 0 0; color: #43574a; font-size: 28rpx; line-height: 1.55; }
.home-logo { flex: none; width: 116rpx; height: 116rpx; border: 1rpx solid #d3e6d9; border-radius: 28rpx; background: #f3fbf5; }
.home-stages { border-color: #eadfd2; }
.home-stages .home-stage { min-height: 104rpx; padding: 16rpx 22rpx; }
.home-stage.home-stage-start { background: #fff6e9; }
.home-stage .icon-tile { width: 68rpx; height: 68rpx; }
.home-stage .icon-tile image { width: 36rpx; height: 36rpx; }
.home-library { display: flex; align-items: center; gap: 14rpx; min-height: 88rpx; margin: 16rpx 0 0; padding: 0 20rpx; color: #285143; font-size: 28rpx; font-weight: 600; }
.home-library-icon { flex: none; width: 34rpx; height: 34rpx; }
.home-library .tab-chevron { margin-left: auto; }

.home-task { margin: 16rpx 0 24rpx; }
.home-task-active { padding: 22rpx 26rpx; border: 1rpx solid #cedfd1; border-radius: 22rpx; background: #e5efe5; }
.home-phase { display: inline-block; color: #285143; font-size: 26rpx; font-weight: 650; padding: 12rpx 0; }
.home-task-active .tab-row-title { margin: 4rpx 0 8rpx; }
.home-action { display: block; margin: 18rpx 0 0; text-align: center; }
.home-wear-total { color: #1c4638; font-size: 42rpx; font-weight: 700; margin: 4rpx 0; font-variant-numeric: tabular-nums; }
.home-wear-state { font-size: 23rpx; background: #cfe3d3; border-radius: 999rpx; padding: 4rpx 13rpx; }
.home-task-link, .home-task-links navigator { display: inline-block; padding-top: 16rpx; color: #285143; font-size: 26rpx; }
.home-task-links { display: flex; flex-wrap: wrap; gap: 0 26rpx; }
.home-sync { color: #5a6358; display: flex; align-items: center; gap: 12rpx; font-size: 23rpx; margin-top: 10rpx; }
.home-sync-retry { flex: none; background: transparent; color: #285143; font-size: 24rpx; margin: 0; padding: 0 10rpx; }
