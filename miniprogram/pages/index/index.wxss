.home-welcome { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 26rpx; background: #e2eee5; border: 1rpx solid #d0e3d6; border-radius: 26rpx; }
.home-welcome-copy { flex: 1; min-width: 0; }
.home-welcome .page-heading { color: #244a3b; font-size: 40rpx; }
.home-welcome .description { margin: 8rpx 0 0; color: #43574a; font-size: 26rpx; line-height: 1.5; }
.home-logo { flex: none; width: 96rpx; height: 96rpx; border: 1rpx solid #d3e6d9; border-radius: 24rpx; background: #f3fbf5; }

.home-task { margin: 14rpx 0 20rpx; }
.home-task-active, .home-task-onboard { padding: 22rpx 24rpx; border: 1rpx solid #cedfd1; border-radius: 24rpx; background: #e8f1ea; }
.home-task-onboard { background: #fffdf9; border-color: #e4d9cb; }
.home-task-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.home-task-badge { font-size: 23rpx; font-weight: 700; color: #285143; background: #d6e8da; padding: 4rpx 14rpx; border-radius: 999rpx; }
.home-phase { display: inline-block; color: #285143; font-size: 25rpx; font-weight: 600; padding: 6rpx 10rpx; }

.home-phase-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 12rpx; }
.phase-pick-btn, button.phase-pick-btn:not([size='mini']) { width: 100%; max-width: none; box-sizing: border-box; margin: 0; padding: 18rpx 14rpx; font-size: 26rpx; font-weight: 600; color: #264a3b; background: #f3f7f4; border: 1rpx solid #cfe0d3; border-radius: 16rpx; line-height: 1.3; }
.phase-pick-btn::after { border: 0; }
.phase-pick-start, button.phase-pick-start:not([size='mini']) { width: 100%; margin: 14rpx 0 0; background: #fff6e9; border-color: #ebd3b0; color: #7a4f13; }

.home-task-active .tab-row-title { margin: 4rpx 0 8rpx; }
.home-action { display: flex; align-items: center; justify-content: center; width: 100%; box-sizing: border-box; margin: 18rpx 0 0; padding: 0 20rpx; text-align: center; }
.home-wear-total { color: #1c4638; font-size: 42rpx; font-weight: 700; margin: 4rpx 0; font-variant-numeric: tabular-nums; }
.home-wear-state { font-size: 23rpx; background: #cfe3d3; border-radius: 999rpx; padding: 4rpx 13rpx; }
.home-task-link, .home-task-links navigator { display: inline-block; padding-top: 16rpx; color: #285143; font-size: 26rpx; }
.home-task-links { display: flex; flex-wrap: wrap; gap: 0 26rpx; }

.home-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-bottom: 12rpx; }
.quick-tile { box-sizing: border-box; background: #fffdf9; border: 1rpx solid #e7ddd2; border-radius: 22rpx; padding: 18rpx 20rpx; min-width: 0; }
.quick-tile-title { margin-top: 12rpx; font-size: 28rpx; font-weight: 700; color: #24362c; }
.quick-tile-sub { margin-top: 4rpx; font-size: 23rpx; color: #61695d; }

.home-stages { border-color: #eadfd2; }
.home-stages .home-stage { min-height: 92rpx; padding: 16rpx 22rpx; }
.home-stage.home-stage-start { background: #fff8ee; }
.home-stage .icon-tile { width: 60rpx; height: 60rpx; }
.home-stage .icon-tile image { width: 32rpx; height: 32rpx; }
.home-sync { color: #5a6358; display: flex; align-items: center; gap: 12rpx; font-size: 23rpx; margin-top: 10rpx; }
.home-sync-retry, button.home-sync-retry:not([size='mini']) { flex: none; width: auto; max-width: none; background: transparent; color: #285143; font-size: 24rpx; margin: 0; padding: 0 10rpx; }

.home-phase { min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }
button.phase-pick-btn:not([size='mini']) { min-height: 44px; }
.home-task-link, .home-task-links navigator { min-height: 44px; box-sizing: border-box; }
