.home-welcome { display: flex; align-items: center; gap: 22rpx; padding: 30rpx 28rpx; background: #f6e8d9; border-radius: 28rpx; }
.home-welcome-copy { flex: 1; min-width: 0; }
.home-welcome .page-heading { font-size: 44rpx; }
.home-welcome .description { margin: 12rpx 0 0; color: #554b40; font-size: 26rpx; }
.home-logo { flex: none; width: 112rpx; height: 112rpx; border-radius: 26rpx; }
.home-stage-dot { flex: none; width: 10rpx; height: 10rpx; background: #759480; border-radius: 50%; }
.home-library { display: flex; justify-content: space-between; align-items: center; min-height: 84rpx; margin: 16rpx 4rpx 0; padding: 0 12rpx; color: #285143; font-size: 28rpx; font-weight: 600; }
