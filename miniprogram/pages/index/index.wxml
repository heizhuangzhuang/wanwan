<view class="container">
  <view class="card home-intro">
    <view class="title">从你关心的阶段开始</view>
    <view class="description muted">查找足内翻相关公开资料，了解出处与阅读条件。</view>
    <view class="actions">
      <button class="btn" bindtap="goSearch">搜索资料</button>
      <button class="btn secondary" bindtap="goTopics">精选专题</button>
    </view>
    <button class="btn secondary" bindtap="goGuides">原创导读</button>
  </view>
  <view wx:if="{{demoMode}}" class="notice">本地演示 · 页面展示的是示例资料。</view>

  <view wx:if="{{loading}}" class="muted">加载中...</view>
  <view wx:elif="{{error}}" class="card">
    <view>{{error}}</view>
    <button class="btn" style="margin-top: 16rpx;" bindtap="loadStages">重试</button>
  </view>

  <view wx:else>
    <view wx:for="{{stages}}" wx:key="key" class="card" data-key="{{item.key}}" data-label="{{item.label}}" bindtap="goStage">
      <view class="title">{{item.label}}</view>
    </view>
  </view>

  <view style="text-align: center; margin-top: 24rpx;" bindtap="goAbout">
    <text class="muted">关于本站、版权与勘误联系方式</text>
  </view>
</view>
