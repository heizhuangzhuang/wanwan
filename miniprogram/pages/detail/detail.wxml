<view class="container">
  <view wx:if="{{loading}}" class="muted">加载中...</view>
  <view wx:elif="{{error}}" class="card">{{error}}</view>
  <view wx:elif="{{resource}}" class="card">
    <view style="font-size: 34rpx; font-weight: 700; margin-bottom: 10rpx;">{{resource.title}}</view>
    <view wx:if="{{resource.originalTitle !== resource.title}}" class="muted" style="margin-bottom: 12rpx;">
      原标题：{{resource.originalTitle}}
    </view>

    <view class="notice">本站介绍：{{resource.intro}}</view>

    <view class="muted" style="margin-bottom: 16rpx;">
      <view>来源：{{resource.sourceName}}</view>
      <view wx:if="{{resource.author}}">作者/机构：{{resource.author}}</view>
      <view>原文日期：{{resource.publishedDate || '未注明'}}</view>
      <view wx:if="{{resource.lastVerifiedDate}}">最后核对：{{resource.lastVerifiedDate}}</view>
      <view wx:if="{{resource.doi}}">DOI：{{resource.doi}}</view>
      <view wx:if="{{resource.pmid}}">PMID：{{resource.pmid}}</view>
    </view>

    <view wx:if="{{resource.linkStatus === 'SOURCE_RETRACTED'}}" class="muted">
      原文已撤回，已暂停推荐。
    </view>
    <view wx:elif="{{resource.entry.type === 'MP_ARTICLE'}}">
      <button class="btn" bindtap="openOfficialAccountArticle">打开公众号原文</button>
    </view>
    <view wx:elif="{{resource.entry.type === 'MINIPROGRAM'}}">
      <button class="btn" bindtap="openOtherMiniProgram">打开来源小程序</button>
    </view>
    <view wx:elif="{{resource.citationUrl}}">
      <view class="muted" style="margin-bottom: 12rpx; word-break: break-all;">
        受限于个人小程序外部网页能力，请复制链接并在系统浏览器中查看原站：{{resource.citationUrl}}
      </view>
      <button class="btn" bindtap="copyCitation">复制出处链接</button>
    </view>
  </view>
</view>
