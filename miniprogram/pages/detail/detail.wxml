<view class="container">
  <view wx:if="{{loading}}" class="muted">加载中...</view>
  <view wx:elif="{{error}}" class="card">
    <view>{{error}}</view>
    <button wx:if="{{retryable}}" class="btn" bindtap="loadDetail">重试</button>
  </view>
  <view wx:elif="{{resource}}" class="card">
    <view style="font-size: 34rpx; font-weight: 700; margin-bottom: 10rpx;">{{resource.title}}</view>
    <view wx:if="{{resource.originalTitle !== resource.title}}" class="muted" style="margin-bottom: 12rpx;">
      原标题：{{resource.originalTitle}}
    </view>

    <view class="notice">本站介绍：{{resource.intro}}</view>

    <view class="muted" style="margin-bottom: 16rpx;">
      <view>{{resource.materialLabel}} · {{resource.accessLabel}}</view>
      <view>来源：{{resource.sourceName}}</view>
      <view wx:if="{{resource.author}}">作者/机构：{{resource.author}}</view>
      <view>原文日期：{{resource.publishedDate || '未注明'}}</view>
      <view wx:if="{{resource.lastVerifiedDate}}">最后核对：{{resource.lastVerifiedDate}}</view>
      <view wx:if="{{resource.doi}}">DOI：{{resource.doi}}</view>
      <view wx:if="{{resource.pmid}}">PMID：{{resource.pmid}}</view>
    </view>

    <view wx:if="{{resource.linkStatus === 'SOURCE_RETRACTED'}}" class="notice">原文已撤回，以下仅保留出处。</view>
    <view wx:elif="{{resource.linkStatus !== 'OK'}}" class="notice">原文入口待核对，可以查看并复制题录。</view>
    <view wx:elif="{{!allowArticle && !allowMiniProgram}}" class="muted description">复制出处后可查找原文。</view>
    <view wx:if="{{entryError}}" class="notice">{{entryError}}</view>
    <view class="actions">
      <button wx:if="{{allowArticle}}" class="btn" bindtap="openOfficialAccountArticle">打开公众号原文</button>
      <button wx:if="{{allowMiniProgram}}" class="btn" bindtap="openOtherMiniProgram">打开来源小程序</button>
      <button class="btn secondary" bindtap="copyCitation">复制出处</button>
    </view>
  </view>
</view>
