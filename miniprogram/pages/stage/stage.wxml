<import src="../../templates/public.wxml" />
<view class="container">
  <view class="page-intro"><view class="page-heading">{{heading}}</view><view class="description">{{intro}}</view></view>
  <block wx:if="{{guide}}">
    <view class="tab-list">
      <navigator class="tab-row" url="{{prepareUrl}}" hover-class="pressed">
        <view class="tab-row-copy tab-row-title">这一阶段可以问医生什么</view>
        <text class="tab-chevron" aria-hidden="true">›</text>
      </navigator>
      <navigator wx:for="{{guide.actions}}" wx:key="url" class="tab-row" url="{{item.url}}" hover-class="pressed">
        <view class="tab-row-copy tab-row-title">{{item.title}}</view>
        <text class="tab-chevron" aria-hidden="true">›</text>
      </navigator>
      <button class="tab-row" bindtap="copyGuideSource">
        <view class="tab-row-copy">
          <view class="tab-row-title">复制参考来源链接</view>
          <view class="tab-row-caption">{{guide.source.title}}</view>
        </view>
      </button>
    </view>
    <view class="section-heading">这一阶段的资料</view>
  </block>
  <picker mode="selector" range="{{materials}}" range-key="label" value="{{typeIndex}}" disabled="{{loading}}" bindchange="onType">
    <view class="filter">{{materials[typeIndex].label}} ▾</view>
  </picker>
  <view class="actions">
    <input class="field" placeholder="按主题标签筛选" maxlength="50" value="{{tag}}" disabled="{{loading}}" bindinput="onTag" bindconfirm="applyTag" />
    <button class="btn" disabled="{{loading}}" bindtap="applyTag">筛选</button>
  </view>
  <view wx:if="{{loading}}" class="muted">正在加载资料…</view>
  <view wx:elif="{{error}}" class="card">
    <view>{{error}}</view>
    <button class="btn" bindtap="retry">重试</button>
  </view>
  <block wx:else>
    <view wx:if="{{!items.length}}" class="card muted">没有符合当前条件的公开资料。</view>
    <template is="resourceCards" data="{{items}}" />
    <template is="pagination" data="{{page, hasNext, loading}}" />
  </block>
</view>
