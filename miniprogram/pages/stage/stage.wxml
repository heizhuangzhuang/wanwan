<import src="../../templates/public.wxml" />
<view class="container">
  <view class="stage-intro motion-reveal">
    <view class="stage-intro-head">
      <view class="page-heading">{{heading}}</view>
      <view wx:if="{{guide}}" class="stage-focus-pill" role="button" bindtap="openStageFocus">本阶段重点 ›</view>
    </view>
    <view class="description clamp-2">{{intro}}</view>
    <view wx:if="{{guide && focusSummaryText}}" class="stage-focus-strip" role="button" bindtap="openStageFocus">
      <text class="stage-focus-strip-label">重点</text>
      <text class="stage-focus-strip-text clamp-1">{{focusSummaryText}}</text>
      <text class="stage-focus-strip-more">详解 ›</text>
    </view>
  </view>

  <block wx:if="{{stageTools.length}}">
    <view class="stage-section-label">本阶段常用工具与准备</view>
    <view class="stage-tool-grid">
      <navigator wx:for="{{stageTools}}" wx:key="title" class="stage-tool-tile motion-press" url="{{item.url}}" hover-class="pressed">
        <view class="icon-tile icon-{{item.tone}}" aria-hidden="true">
          <image src="/assets/icons/{{item.icon}}.png" mode="aspectFit" />
        </view>
        <view class="stage-tool-copy">
          <view class="stage-tool-title clamp-1">{{item.title}}</view>
          <view class="stage-tool-sub clamp-1">{{item.sub}}</view>
        </view>
      </navigator>
    </view>
  </block>

  <view wx:if="{{guide}}" class="stage-tabs-wrap">
    <view class="sticky-tabs" role="tablist">
      <view class="sticky-tab {{activeTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="selectTab">全部内容</view>
      <view class="sticky-tab {{activeTab === 'guides' ? 'active' : ''}}" data-tab="guides" bindtap="selectTab">原创导读</view>
      <view class="sticky-tab {{activeTab === 'resources' ? 'active' : ''}}" data-tab="resources" bindtap="selectTab">资料卡</view>
    </view>
    <view class="stage-format-hint" role="button" bindtap="showFormatHelp">导读与资料卡有什么区别？</view>
  </view>

  <block wx:if="{{guide && (activeTab === 'all' || activeTab === 'guides')}}">
    <block wx:if="{{articles.length}}">
      <view wx:if="{{activeTab === 'all'}}" class="stage-bar">
        <text class="stage-section-label">本阶段原创导读</text>
        <navigator wx:if="{{moreArticles || articles.length > 1}}" class="stage-more-inline" url="{{articlesUrl}}">全部导读 ›</navigator>
      </view>
      <scroll-view wx:if="{{activeTab === 'all'}}" scroll-x class="stage-guide-carousel-scroll" show-scrollbar="{{false}}">
        <view class="stage-guide-carousel">
          <navigator wx:for="{{articles}}" wx:key="name" class="card guide-card stage-guide-carousel-item motion-press" hover-class="pressed"
            url="/pages/reading/reading?kind=guide&name={{item.name}}">
            <view class="guide-card-head">
              <text class="badge badge-sage">原创导读</text>
              <text class="muted">分节阅读 ›</text>
            </view>
            <view class="resource-card-title clamp-2">{{item.title}}</view>
            <view wx:if="{{item.excerpt}}" class="resource-card-intro clamp-2">{{item.excerpt}}</view>
          </navigator>
        </view>
      </scroll-view>
      <block wx:else>
        <navigator wx:for="{{articles}}" wx:key="name" class="card guide-card motion-press" hover-class="pressed"
          url="/pages/reading/reading?kind=guide&name={{item.name}}">
          <view class="guide-card-head">
            <text class="badge badge-sage">原创导读</text>
            <text class="muted">分节阅读 ›</text>
          </view>
          <view class="resource-card-title clamp-2">{{item.title}}</view>
          <view wx:if="{{item.excerpt}}" class="resource-card-intro clamp-2">{{item.excerpt}}</view>
        </navigator>
        <navigator wx:if="{{moreArticles}}" class="text-link stage-more-link" url="{{articlesUrl}}">查看本阶段全部导读 ›</navigator>
      </block>
    </block>
    <view wx:elif="{{activeTab === 'guides'}}" class="card muted">
      这一阶段暂未发布原创导读，可查看上方的阶段工具或切换到「资料卡」。
    </view>
  </block>

  <block wx:if="{{!guide || activeTab === 'all' || activeTab === 'resources'}}">
    <view wx:if="{{guide && activeTab === 'all'}}" class="stage-bar">
      <text class="stage-section-label">本阶段精选资料卡</text>
      <text wx:if="{{totalItems > 3}}" class="stage-more-inline" data-tab="resources" bindtap="selectTab">全部 {{totalItems}} 条 ›</text>
    </view>
    <view wx:if="{{demoMode}}" class="notice">本地测试样本 · 虚构内容</view>
    <block wx:if="{{!guide || activeTab === 'resources'}}">
      <view class="stage-filter-bar">
        <scroll-view scroll-x class="filter-chips-scroll" show-scrollbar="{{false}}">
          <view class="filter-chips">
            <view wx:for="{{materials}}" wx:key="label" class="filter-chip {{typeIndex === index ? 'active' : ''}}"
              role="button" data-index="{{index}}" bindtap="selectType">{{item.label}}</view>
          </view>
        </scroll-view>
        <text class="stage-tag-toggle" bindtap="toggleTagFilter">{{showTagFilter ? '收起 ▴' : '标签 ▾'}}</text>
      </view>
      <view wx:if="{{showTagFilter}}" class="actions stage-tag">
        <input class="field" placeholder="按主题标签筛选" maxlength="50" value="{{tag}}" disabled="{{loading}}" bindinput="onTag" bindconfirm="applyTag" />
        <button class="btn motion-press" disabled="{{loading}}" bindtap="applyTag"
          hover-class="pressed" hover-start-time="0" hover-stay-time="90">筛选</button>
      </view>
    </block>
    <view wx:if="{{loading}}" class="muted">正在加载资料…</view>
    <view wx:elif="{{error}}" class="card">
      <view>{{error}}</view>
      <button class="btn" bindtap="retry">重试</button>
    </view>
    <block wx:else>
      <view wx:if="{{!items.length}}" class="card muted">
        <text wx:if="{{typeIndex || submittedTag}}">没有符合当前筛选条件的资料，可以更换类型或标签。</text>
        <text wx:elif="{{guide}}">这一阶段暂未收录资料卡，可先使用上方工具或查看原创导读。</text>
        <text wx:else>暂未收录公开资料。</text>
      </view>
      <template is="resourceCards" data="{{items: guide && activeTab === 'all' ? previewItems : items}}" />
      <button wx:if="{{guide && activeTab === 'all' && totalItems > 3}}" class="btn secondary stage-view-all-btn" data-tab="resources" bindtap="selectTab">
        查看本阶段全部 {{totalItems}} 条资料卡与筛选 ›
      </button>
      <template wx:if="{{!guide || activeTab === 'resources'}}" is="pagination" data="{{page, hasNext, loading}}" />
    </block>
  </block>

  <view wx:if="{{guide}}" class="stage-source-foot" bindtap="copyGuideSource">
    参考出处：{{guide.source.title}}（点击复制链接）
  </view>

  <view wx:if="{{guide && showFocusModal}}" class="stage-focus-mask" catchtap="closeStageFocus" catchtouchmove="noop">
    <view class="stage-focus-sheet" catchtap="noop" role="dialog" aria-modal="true">
      <view class="stage-focus-handle" aria-hidden="true"></view>
      <view class="stage-focus-sheet-head">
        <view>
          <view class="stage-focus-sheet-kicker">本阶段重点工作</view>
          <view class="stage-focus-sheet-title">{{heading}}</view>
        </view>
        <view class="stage-focus-close" role="button" aria-label="关闭" bindtap="closeStageFocus">×</view>
      </view>
      <scroll-view scroll-y class="stage-focus-scroll">
        <view class="stage-focus-goal">
          <view class="stage-focus-goal-label">这一阶段最核心的目标</view>
          <view class="stage-focus-goal-text">{{guide.focus.goal}}</view>
        </view>
        <view class="stage-focus-list">
          <view wx:for="{{guide.focus.items}}" wx:key="title" class="stage-focus-item">
            <view class="stage-focus-num">0{{index + 1}}</view>
            <view class="stage-focus-item-body">
              <view class="stage-focus-item-title">{{item.title}}</view>
              <view class="stage-focus-item-detail">{{item.detail}}</view>
            </view>
          </view>
        </view>
        <view class="stage-focus-reminder">
          <view class="stage-focus-reminder-label">安心提示与边界</view>
          <view class="stage-focus-reminder-text">{{guide.focus.reminder}}</view>
        </view>
        <view class="stage-focus-source" bindtap="copyGuideSource">
          参考出处：{{guide.source.title}}（点击复制链接）
        </view>
      </scroll-view>
      <view class="stage-focus-footer">
        <button wx:if="{{prepareUrl}}" class="btn stage-focus-cta" bindtap="goPrepareFromModal">打开本阶段问医生清单</button>
        <button class="btn secondary stage-focus-ok" bindtap="closeStageFocus">我知道了</button>
      </view>
    </view>
  </view>
</view>
