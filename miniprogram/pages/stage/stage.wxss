.stage-intro {
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  background: #e2eee5;
  border: 1rpx solid #d0e3d6;
  border-radius: 22rpx;
}
.stage-intro-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.stage-intro .page-heading { color: #244a3b; font-size: 38rpx; }
.stage-intro .description { margin: 8rpx 0 0; line-height: 1.5; font-size: 26rpx; color: #43574a; }
.stage-focus-strip {
  margin-top: 16rpx;
  padding: 18rpx 20rpx 0;
  background: #fffdf9;
  border: 1rpx solid #c8ddd0;
  border-radius: 16rpx;
}
.stage-focus-strip-label { font-size: 24rpx; font-weight: 700; color: #244a3b; margin-bottom: 12rpx; }
.stage-focus-summary-item { display: flex; gap: 12rpx; margin: 10rpx 0; color: #2e4539; font-size: 25rpx; line-height: 1.5; }
.stage-focus-summary-number { flex: none; color: #577d65; font-weight: 700; }
.stage-focus-pill, button.stage-focus-pill:not([size='mini']) {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: none;
  min-height: 44px;
  box-sizing: border-box;
  margin: 12rpx 0 0;
  padding: 10rpx 0;
  border: 0;
  border-top: 1rpx solid #e0e8df;
  border-radius: 0;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #2c5a49;
  background: transparent;
}
.stage-focus-pill::after { border: 0; }
.stage-tabs-wrap { margin-bottom: 6rpx; }
.stage-format-hint {
  text-align: right;
  font-size: 22rpx;
  color: #5e6d64;
  padding: 4rpx 6rpx 6rpx;
}

.stage-section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2b3a32;
  margin: 18rpx 0 12rpx;
}
.stage-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 12rpx;
}
.stage-bar .stage-section-label { margin: 0; }
.stage-more-inline { font-size: 24rpx; font-weight: 600; color: #376052; }

.stage-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.stage-tool-tile {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fffdf9;
  border: 1rpx solid #e7ddd2;
  border-radius: 20rpx;
  padding: 16rpx 16rpx;
  box-sizing: border-box;
  min-width: 0;
}
.stage-tool-tile .icon-tile { width: 56rpx; height: 56rpx; border-radius: 14rpx; }
.stage-tool-tile .icon-tile image { width: 30rpx; height: 30rpx; }
.stage-tool-copy { flex: 1; min-width: 0; }
.stage-tool-title { font-size: 26rpx; font-weight: 700; color: #24362c; line-height: 1.3; }
.stage-tool-sub { margin-top: 4rpx; font-size: 21rpx; color: #61695d; line-height: 1.3; }

.stage-filter-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 6rpx 0 12rpx;
}
.filter-chips-scroll { flex: 1; min-width: 0; height: 70rpx; white-space: nowrap; }
.stage-tag-toggle {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  color: #376052;
  padding: 10rpx 8rpx;
}
.stage-tag { margin-top: 0; margin-bottom: 16rpx; }
.stage-tag .btn { flex: 0 0 136rpx; }
.stage-more-link { display: block; text-align: center; margin-top: 8rpx; }
.stage-guide-carousel-scroll { width: 100%; white-space: nowrap; margin-bottom: 8rpx; }
.stage-guide-carousel { display: inline-flex; gap: 16rpx; padding: 2rpx 2rpx 8rpx; }
.stage-guide-carousel-item {
  width: 560rpx;
  flex-shrink: 0;
  white-space: normal;
  margin: 0;
  box-sizing: border-box;
}
.stage-view-all-btn { margin: 8rpx 0 16rpx; font-size: 27rpx; min-height: 78rpx; }

.stage-source-foot {
  margin-top: 24rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: 23rpx;
  color: #6a7266;
  text-decoration: underline;
}

.stage-focus-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(23, 38, 31, 0.52);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.stage-focus-sheet {
  background: #fffdf9;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  padding: 16rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.stage-focus-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d5dcd4;
  margin: 0 auto 14rpx;
}
.stage-focus-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #ece5db;
}
.stage-focus-sheet-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: #376052;
  margin-bottom: 4rpx;
}
.stage-focus-sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f3329;
  line-height: 1.25;
}
.stage-focus-close {
  flex: none;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #f1ede4;
  color: #3e4c44;
  font-size: 38rpx;
  line-height: 44px;
  text-align: center;
}
.stage-focus-scroll {
  max-height: 56vh;
  padding: 18rpx 0;
  box-sizing: border-box;
}
.stage-focus-goal {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #e5f0e8;
  border: 1rpx solid #cfe2d5;
  margin-bottom: 18rpx;
}
.stage-focus-goal-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #244a3b;
  margin-bottom: 6rpx;
}
.stage-focus-goal-text {
  font-size: 27rpx;
  line-height: 1.55;
  color: #22352c;
}
.stage-focus-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.stage-focus-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #f8f5ef;
  border: 1rpx solid #ebe3d7;
}
.stage-focus-num {
  flex: none;
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  background: #2c5a49;
  color: #fffdf9;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-align: center;
}
.stage-focus-item-body { flex: 1; min-width: 0; }
.stage-focus-item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f3329;
  line-height: 1.35;
  margin-bottom: 4rpx;
}
.stage-focus-item-detail {
  font-size: 25rpx;
  line-height: 1.55;
  color: #4b5951;
}
.stage-focus-reminder {
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #fcf3de;
  border: 1rpx solid #ebd9ae;
}
.stage-focus-reminder-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #7c511d;
  margin-bottom: 6rpx;
}
.stage-focus-reminder-text {
  font-size: 25rpx;
  line-height: 1.55;
  color: #5e411d;
}
.stage-focus-source {
  margin-top: 16rpx;
  padding: 8rpx 4rpx;
  font-size: 22rpx;
  color: #6a7266;
  text-decoration: underline;
}
.stage-focus-footer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #ece5db;
}
.stage-focus-footer .btn {
  width: auto !important;
  min-width: 0;
  margin: 0 !important;
  min-height: 82rpx;
  font-size: 27rpx;
  padding: 0 22rpx;
}
.stage-focus-cta { flex: 1.45; }
.stage-focus-ok { flex: 1; }

.stage-format-hint, .stage-source-foot, .stage-focus-source, .stage-more-inline, .stage-tag-toggle { min-height: 44px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.stage-format-hint { justify-content: flex-end; }
.stage-focus-footer .btn { min-height: 44px; }
