.stage-intro {
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  background: #e2eee5;
  border: 1rpx solid #d0e3d6;
  border-radius: 22rpx;
}
.stage-intro-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.stage-intro .page-heading { color: #244a3b; font-size: 38rpx; }
.stage-intro .description { margin: 8rpx 0 0; line-height: 1.5; font-size: 26rpx; color: #43574a; }
.stage-help-link {
  flex: none;
  font-size: 23rpx;
  font-weight: 600;
  color: #2c5a49;
  background: rgba(255, 253, 249, 0.78);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.stage-section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2b3a32;
  margin: 18rpx 0 12rpx;
}
.stage-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 12rpx;
}
.stage-bar .stage-section-label { margin: 0; }
.stage-more-inline { font-size: 24rpx; font-weight: 600; color: #376052; }

.stage-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.stage-tool-tile {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fffdf9;
  border: 1rpx solid #e7ddd2;
  border-radius: 20rpx;
  padding: 16rpx 16rpx;
  box-sizing: border-box;
  min-width: 0;
}
.stage-tool-tile .icon-tile { width: 56rpx; height: 56rpx; border-radius: 14rpx; }
.stage-tool-tile .icon-tile image { width: 30rpx; height: 30rpx; }
.stage-tool-copy { flex: 1; min-width: 0; }
.stage-tool-title { font-size: 26rpx; font-weight: 700; color: #24362c; line-height: 1.3; }
.stage-tool-sub { margin-top: 4rpx; font-size: 21rpx; color: #61695d; line-height: 1.3; }

.stage-filter-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 6rpx 0 12rpx;
}
.filter-chips-scroll { flex: 1; min-width: 0; height: 70rpx; white-space: nowrap; }
.stage-tag-toggle {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  color: #376052;
  padding: 10rpx 8rpx;
}
.stage-tag { margin-top: 0; margin-bottom: 16rpx; }
.stage-tag .btn { flex: 0 0 136rpx; }
.stage-more-link { display: block; text-align: center; margin-top: 8rpx; }
.stage-guide-carousel-scroll { width: 100%; white-space: nowrap; margin-bottom: 8rpx; }
.stage-guide-carousel { display: inline-flex; gap: 16rpx; padding: 2rpx 2rpx 8rpx; }
.stage-guide-carousel-item {
  width: 560rpx;
  flex-shrink: 0;
  white-space: normal;
  margin: 0;
  box-sizing: border-box;
}
.stage-view-all-btn { margin: 8rpx 0 16rpx; font-size: 27rpx; min-height: 78rpx; }

.stage-source-foot {
  margin-top: 24rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: 23rpx;
  color: #6a7266;
  text-decoration: underline;
}
