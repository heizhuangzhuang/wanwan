<import src="../../templates/public.wxml" />
<view class="container">
  <view class="page-intro">
    <view class="page-heading">{{stageLabel ? stageLabel + ' · 原创导读' : '跟着主题慢慢读'}}</view>
    <view wx:if="{{!stageLabel}}" class="description">专题是资料合集，导读是站内白话长文。</view>
  </view>
  <view wx:if="{{!stageLabel}}" class="actions">
    <button class="btn {{kind === 'topic' ? '' : 'secondary'}}" disabled="{{loading}}" data-kind="topic" bindtap="selectKind">精选专题</button>
    <button class="btn {{kind === 'guide' ? '' : 'secondary'}}" disabled="{{loading}}" data-kind="guide" bindtap="selectKind">原创导读</button>
  </view>
  <view wx:if="{{loading}}" class="muted">加载中…</view>
  <view wx:elif="{{error}}" class="card">
    <view>{{error}}</view>
    <button class="btn" bindtap="retry">重试</button>
  </view>
  <block wx:else>
    <view wx:if="{{!items.length}}" class="card muted">暂无可阅读的{{kind === 'topic' ? '专题' : '导读'}}。</view>
    <view wx:for="{{items}}" wx:key="name" class="card {{kind === 'guide' ? 'guide-card' : ''}} motion-press" hover-class="pressed" data-name="{{item.name}}" bindtap="openReading">
      <view class="badge-row">
        <text class="badge {{kind === 'guide' ? 'badge-sage' : 'badge-gold'}}">{{kind === 'guide' ? '原创导读' : '精选专题'}}</text>
        <text wx:if="{{kind === 'topic'}}" class="badge badge-outline">{{item.resourceCount}} 条资料</text>
        <text wx:if="{{item.date}}" class="muted badge-right">{{item.date}}</text>
      </view>
      <view class="resource-card-title clamp-2">{{item.title}}</view>
      <view wx:if="{{item.intro}}" class="resource-card-intro clamp-2">{{item.intro}}</view>
    </view>
    <template is="pagination" data="{{page, hasNext, loading}}" />
  </block>
</view>
