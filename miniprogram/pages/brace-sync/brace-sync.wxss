.archive-card { border-top: 6rpx solid #285143; }
.archive-date { margin: 16rpx 0; color: #526257; font-size: 26rpx; }
.archive-actions { display: grid; gap: 12rpx; margin-top: 22rpx; }
.archive-actions .btn { margin: 0; }
.archive-link, .archive-withdraw { display: block; margin: 16rpx 0; padding: 14rpx 0; color: #285143; }
.archive-withdraw::after { border: 0; }
.archive-withdraw, button.archive-withdraw:not([size='mini']) { width: 100%; max-width: none; margin: 16rpx 0; padding: 14rpx 0; background: transparent; color: #8e3e33; font-size: 26rpx; font-weight: 500; text-align: left; }
