<import src="../../templates/public.wxml" />
<view class="container">
  <view wx:if="{{loading}}" class="muted">加载中…</view>
  <view wx:elif="{{error}}" class="card">
    <view>{{error}}</view>
    <view class="actions">
      <button wx:if="{{retryable}}" class="btn" bindtap="load">重试</button>
      <button class="btn secondary" bindtap="backToLibrary">查看全部资料</button>
    </view>
  </view>
  <block wx:else>
    <view class="card">
      <view class="page-heading">{{title}}</view>
      <view wx:if="{{intro}}" class="description">{{intro}}</view>
      <view wx:if="{{author}}" class="muted">作者 {{author}}</view>
      <view wx:if="{{date}}" class="muted">发布于 {{date}}</view>
      <block wx:if="{{kind === 'guide'}}">
        <rich-text wx:if="{{body.length}}" class="guide-article" nodes="{{body}}" user-select />
        <view wx:else class="description">暂无可显示的正文。</view>
      </block>
    </view>
    <block wx:if="{{kind === 'topic'}}">
      <template wx:if="{{items.length}}" is="resourceCards" data="{{items}}" />
      <view wx:else class="card muted">该专题暂无公开资料。</view>
    </block>
    <view class="actions">
      <button class="btn" open-type="share">分享{{kind === 'guide' ? '导读' : '专题'}}</button>
      <button class="btn secondary" bindtap="backToLibrary">查看全部资料</button>
    </view>
  </block>
</view>
