.library .search-entry { margin: 0 0 18rpx; }
.library-prenatal-banner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 12rpx 0 10rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f9ece0 0%, #f5e4d4 100%);
  border: 1rpx solid #ebd6c1;
  box-sizing: border-box;
}
.library-prenatal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #fffdf9;
  box-shadow: 0 2rpx 8rpx rgba(110, 53, 49, 0.08);
}
.library-prenatal-icon image { width: 38rpx; height: 38rpx; }
.library-prenatal-copy { flex: 1; min-width: 0; }
.library-prenatal-head { display: flex; align-items: center; gap: 10rpx; }
.library-prenatal-title {
  font-family: "Songti SC", "Noto Serif CJK SC", serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #27382f;
  line-height: 1.3;
}
.library-prenatal-tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #7c3f35;
  color: #fffdf9;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.5;
}
.library-prenatal-desc {
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #54463d;
  line-height: 1.45;
}

.library-stage-bar { margin-bottom: 12rpx; }
.library-stage-head, .library-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 10rpx;
}
.library-stage-head { margin-top: 4rpx; }
.library-section-title { font-size: 30rpx; font-weight: 700; color: #24362c; }
.library-more-link { font-size: 24rpx; font-weight: 600; color: #376052; }
.library-stage-scroll { width: 100%; height: 72rpx; white-space: nowrap; }
.library-empty { padding: 20rpx 24rpx; font-size: 26rpx; }
.library-empty-action { margin-top: 12rpx; font-size: 25rpx; font-weight: 600; color: #376052; }

.guide-carousel-scroll { width: 100%; white-space: nowrap; margin-bottom: 8rpx; }
.guide-carousel { display: inline-flex; gap: 16rpx; padding: 2rpx 2rpx 8rpx; }
.guide-carousel-item {
  width: 560rpx;
  flex-shrink: 0;
  white-space: normal;
  margin: 0;
  box-sizing: border-box;
}
