.library .search-entry { margin: 0 0 18rpx; }
.library-prenatal-banner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 12rpx 0 10rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f9ece0 0%, #f5e4d4 100%);
  border: 1rpx solid #ebd6c1;
  box-sizing: border-box;
}
.library-prenatal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #fffdf9;
  box-shadow: 0 2rpx 8rpx rgba(110, 53, 49, 0.08);
}
.library-prenatal-icon image { width: 38rpx; height: 38rpx; }
.library-prenatal-copy { flex: 1; min-width: 0; }
.library-prenatal-head { display: flex; align-items: center; gap: 10rpx; }
.library-prenatal-title {
  font-family: "Songti SC", "Noto Serif CJK SC", serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #27382f;
  line-height: 1.3;
}
.library-prenatal-tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #7c3f35;
  color: #fffdf9;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.5;
}
.library-prenatal-desc {
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #54463d;
  line-height: 1.45;
}

.library-stage-bar { margin-bottom: 12rpx; }
.library-stage-head, .library-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 10rpx;
}
.library-stage-head { margin-top: 4rpx; }
.library-section-title { font-size: 30rpx; font-weight: 700; color: #24362c; }
.library-more-link { font-size: 24rpx; font-weight: 600; color: #376052; }
.library-stage-scroll { width: 100%; height: 72rpx; white-space: nowrap; }
.library-empty { padding: 20rpx 24rpx; font-size: 26rpx; }
.library-empty-action { margin-top: 12rpx; font-size: 25rpx; font-weight: 600; color: #376052; }

.feed-heading { margin-top: 28rpx; margin-bottom: 16rpx; }
.feed-heading .library-more-link { display: flex; align-items: center; min-height: 44px; }
.reading-feed { background: #fffdf9; border: 1rpx solid #e7ddd2; border-radius: 24rpx; overflow: hidden; }
.feed-item { padding: 28rpx 26rpx 8rpx; }
.feed-item + .feed-item { border-top: 12rpx solid #f4eee6; }
.feed-byline { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.feed-source-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 16rpx; background: #edf2e9; }
.feed-source-icon image { width: 32rpx; height: 32rpx; }
.feed-source-editor { background: #e9f4ed; }
.feed-source-editor image { width: 62rpx; height: 62rpx; border-radius: 16rpx; }
.feed-source-copy { flex: 1; min-width: 0; }
.feed-source-name { color: #35483d; font-size: 25rpx; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.feed-meta { color: #61685e; font-size: 22rpx; line-height: 1.5; margin-top: 2rpx; }
.feed-literature-label { flex: none; font-size: 21rpx; color: #735029; background: #f4ebda; padding: 4rpx 12rpx; border-radius: 8rpx; }
.feed-title { display: block; min-height: 44px; color: #24362c; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 34rpx; font-weight: 650; line-height: 1.5; margin-bottom: 12rpx; overflow-wrap: anywhere; }
.feed-excerpt { font-size: 29rpx; line-height: 1.8; color: #475145; overflow-wrap: anywhere; white-space: pre-line; }
.feed-excerpt-collapsed { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }
.feed-expand, button.feed-expand:not([size='mini']) { display: flex; align-items: center; min-height: 44px; width: auto; max-width: none; margin: 0; padding: 0; background: transparent; color: #376052; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.feed-expand::after, .feed-share::after, .feed-load-more::after, .feed-reset::after { border: 0; }
.feed-image-wrap { position: relative; margin-top: 20rpx; border-radius: 16rpx; overflow: hidden; background: #edf2e9; }
.feed-cover { display: block; width: 100%; height: 330rpx; }
.feed-image-label { position: absolute; right: 14rpx; bottom: 14rpx; color: #fffdf9; background: rgba(30, 50, 41, .8); border-radius: 8rpx; padding: 4rpx 12rpx; font-size: 22rpx; }
.feed-citation { font-size: 23rpx; color: #62695e; margin-top: 16rpx; line-height: 1.5; overflow-wrap: anywhere; }
.feed-actions { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; border-top: 1rpx solid #efe8de; }
.feed-read { display: flex; align-items: center; min-height: 44px; color: #376052; font-size: 26rpx; font-weight: 600; }
.feed-share, button.feed-share:not([size='mini']) { display: flex; align-items: center; flex: none; min-height: 44px; width: auto; max-width: none; margin: 0; padding: 0 6rpx; background: transparent; color: #61685e; font-size: 24rpx; font-weight: 400; line-height: 1.5; }
.feed-loading, .feed-end { padding: 28rpx 12rpx; color: #61685e; font-size: 25rpx; line-height: 1.6; text-align: center; }
.feed-load-more, button.feed-load-more:not([size='mini']), .feed-reset, button.feed-reset:not([size='mini']) { display: flex; align-items: center; justify-content: center; min-height: 44px; width: 100%; max-width: none; padding: 0 16rpx; margin: 0; background: transparent; color: #376052; font-size: 26rpx; font-weight: 600; line-height: 1.5; }

.directory-toggle, button.directory-toggle:not([size='mini']) { display: flex; flex: none; align-items: center; justify-content: center; gap: 10rpx; min-height: 44px; width: auto; max-width: none; margin: 0; padding: 0 12rpx; background: transparent; color: #376052; font-size: 25rpx; font-weight: 600; line-height: 1.4; border-radius: 12rpx; }
.directory-toggle::after { border: 0; }
.directory-toggle-open { background: #e8f0e8 !important; }
.directory-caret { font-size: 30rpx; }
.reading-directory { background: #fffdf9; border: 1rpx solid #cdddcf; border-radius: 20rpx; margin: -4rpx 0 20rpx; padding: 0 20rpx; }
.directory-row { display: flex; align-items: center; gap: 16rpx; min-height: 44px; padding: 18rpx 0; box-sizing: border-box; }
.directory-row + .directory-row { border-top: 1rpx solid #ece5db; }
.directory-row .icon-tile { width: 56rpx; height: 56rpx; border-radius: 14rpx; }
.directory-row .icon-tile image { width: 30rpx; height: 30rpx; }
.directory-copy { flex: 1; min-width: 0; }
.directory-title { color: #24362c; font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.directory-caption { color: #61685e; font-size: 23rpx; line-height: 1.5; margin-top: 2rpx; }
.directory-topics-label { color: #61685e; font-size: 23rpx; border-top: 1rpx solid #ece5db; padding-top: 16rpx; }
.directory-topic { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 44px; padding: 12rpx 0; color: #376052; font-size: 25rpx; line-height: 1.5; }
