<import src="../../templates/public.wxml" />
<view class="container tab-page library">
  <navigator class="search-entry motion-press" url="/pages/search/search" hover-class="pressed" hover-start-time="0" hover-stay-time="90">
    <view class="search-mark" aria-hidden="true" />
    <text>标题、来源或关键词</text>
    <text class="search-action">搜索</text>
  </navigator>

  <view class="library-stage-bar">
    <view class="library-stage-head">
      <text class="library-section-title">按阶段看文章与资料</text>
      <navigator wx:if="{{selectedStage}}" class="library-more-link" url="{{stageUrl}}">进入阶段专区 ›</navigator>
    </view>
    <scroll-view scroll-x class="library-stage-scroll" show-scrollbar="{{false}}">
      <view class="filter-chips">
        <view wx:for="{{stageFilters}}" wx:key="label" class="filter-chip {{selectedStage === item.key ? 'active' : ''}}"
          role="button" data-key="{{item.key}}" bindtap="selectStage">{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <navigator wx:if="{{!selectedStage || selectedStage === 'JUST_FOUND' || selectedStage === 'PRENATAL'}}"
    class="library-prenatal-banner motion-press" url="/pages/prenatal/prenatal"
    hover-class="pressed" hover-start-time="0" hover-stay-time="90">
    <view class="library-prenatal-icon" aria-hidden="true">
      <image src="/assets/icons/scan-heart.png" mode="aspectFit" />
    </view>
    <view class="library-prenatal-copy">
      <view class="library-prenatal-head">
        <text class="library-prenatal-title">产前检查专项</text>
        <text class="library-prenatal-tag">检查说明</text>
      </view>
      <view class="library-prenatal-desc clamp-1">结构超声 · 羊水穿刺 · CMA · 全外显子测序</view>
    </view>
    <text class="tab-chevron" aria-hidden="true">›</text>
  </navigator>

  <view class="library-bar feed-heading">
    <text class="library-section-title">{{selectedStage ? selectedStageLabel + ' · 阅读' : '精选阅读'}}</text>
    <button class="directory-toggle {{directoryOpen ? 'directory-toggle-open' : ''}}" bindtap="toggleDirectory" aria-expanded="{{directoryOpen}}" aria-controls="reading-directory">阅读目录<text class="directory-caret" aria-hidden="true">{{directoryOpen ? '⌃' : '⌄'}}</text></button>
  </view>
  <view wx:if="{{directoryOpen}}" id="reading-directory" class="reading-directory">
    <navigator class="directory-row" url="{{guidesUrl}}" bindtap="closeDirectory" hover-class="pressed">
      <view class="icon-tile icon-blue" aria-hidden="true"><image src="/assets/icons/book-open.png" mode="aspectFit" /></view>
      <view class="directory-copy"><view class="directory-title">{{selectedStage ? '本阶段原创导读' : '原创导读'}}</view><view class="directory-caption">站内长文，按章节阅读</view></view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
    <navigator class="directory-row" url="{{stageUrl}}" bindtap="closeDirectory" hover-class="pressed">
      <view class="icon-tile icon-sage" aria-hidden="true"><image src="/assets/icons/files.png" mode="aspectFit" /></view>
      <view class="directory-copy"><view class="directory-title">{{selectedStage ? '本阶段资料卡' : '全部资料卡'}}</view><view class="directory-caption">按类型与标签核对资料出处</view></view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
    <navigator class="directory-row" url="/pages/topics/topics" bindtap="closeDirectory" hover-class="pressed">
      <view class="icon-tile icon-gold" aria-hidden="true"><image src="/assets/icons/layers.png" mode="aspectFit" /></view>
      <view class="directory-copy"><view class="directory-title">阅读专题</view><view class="directory-caption">围绕一个问题，连着看相关资料</view></view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
    <block wx:if="{{!selectedStage && topics.length}}">
      <view class="directory-topics-label">精选专题</view>
      <navigator wx:for="{{topics}}" wx:key="name" class="directory-topic" url="{{item.url}}" bindtap="closeDirectory" hover-class="pressed"><text>{{item.title}}</text><text aria-hidden="true">›</text></navigator>
    </block>
  </view>
  <view wx:if="{{loading && !feed.length}}" class="feed-loading" aria-live="polite">正在整理阅读内容…</view>
  <view class="reading-feed">
    <view wx:for="{{feed}}" wx:key="id" class="feed-item">
      <view class="feed-byline">
        <view class="feed-source-icon {{item.kind === 'guide' ? 'feed-source-editor' : ''}}" aria-hidden="true">
          <image src="{{item.kind === 'guide' ? '/assets/logo.png' : '/assets/icons/files.png'}}" mode="aspectFit" />
        </view>
        <view class="feed-source-copy">
          <view class="feed-source-name">{{item.source}}</view>
          <view class="feed-meta">{{item.label}}{{item.date ? ' · ' + item.date : ''}}</view>
        </view>
        <text wx:if="{{item.literature}}" class="feed-literature-label">文献译读</text>
      </view>
      <navigator class="feed-title" url="{{item.url}}" hover-class="pressed">{{item.title}}</navigator>
      <view wx:if="{{item.excerpt}}" class="feed-excerpt {{expanded[item.id] ? '' : 'feed-excerpt-collapsed'}}"><text selectable>{{item.excerpt}}</text></view>
      <button wx:if="{{item.excerpt.length > 72}}" class="feed-expand" data-id="{{item.id}}" bindtap="toggleExcerpt">{{expanded[item.id] ? '收起摘要' : '展开摘要'}}</button>
      <view wx:if="{{item.coverUrl && brokenImages[item.id] !== item.coverUrl}}" class="feed-image-wrap" role="button" aria-label="查看文章配图" data-id="{{item.id}}" bindtap="previewCover">
        <image class="feed-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load data-id="{{item.id}}" data-url="{{item.coverUrl}}" binderror="imageError" />
        <text class="feed-image-label">查看大图</text>
      </view>
      <view wx:if="{{item.citation}}" class="feed-citation">文献出处：{{item.citation}}</view>
      <view class="feed-actions">
        <navigator class="feed-read" url="{{item.url}}" hover-class="pressed">{{item.action}}<text aria-hidden="true"> ›</text></navigator>
        <button class="feed-share" open-type="share" data-id="{{item.id}}" aria-label="分享这篇内容"><text>分享给家人</text></button>
      </view>
    </view>
  </view>
  <view wx:if="{{featuredError}}" class="reading-state tab-retry" aria-live="polite">
    <text>部分内容暂时无法加载，已加载的内容仍可阅读。</text>
    <button class="btn secondary compact" bindtap="retryFeed" disabled="{{loading}}">重试</button>
  </view>
  <view wx:elif="{{!loading && !feed.length}}" class="card library-empty">
    <view>「{{selectedStageLabel}}」暂未发布文章或资料。</view>
    <button wx:if="{{selectedStage}}" class="feed-reset" bindtap="resetStage">查看全部阶段资料</button>
  </view>
  <view wx:if="{{feed.length && !featuredError}}" class="feed-end" aria-live="polite">
    <text wx:if="{{loadingMore}}">正在加载更多…</text>
    <block wx:elif="{{moreError}}"><text>后面的内容暂时无法加载。</text><button class="feed-load-more" bindtap="loadMore">重试加载</button></block>
    <button wx:elif="{{hasMoreGuides || hasMoreResources}}" class="feed-load-more" bindtap="loadMore" disabled="{{loading}}">继续往下读</button>
    <text wx:else>本阶段内容已读到底，之后还会继续整理。</text>
  </view>

</view>
