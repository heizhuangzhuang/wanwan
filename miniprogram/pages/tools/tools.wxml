<view class="container tab-page">
  <view class="tools-heading"><view class="page-heading">家庭工具</view></view>
  <view class="tools-context">{{phaseLabel ? '按首页的「' + phaseLabel + '」优先排列，其他工具也可随时使用。' : '先从就诊准备开始，也可使用下方的记录工具。'}}</view>
  <block wx:for="{{groups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="key">
    <view class="section-heading tools-section-heading">{{group.title}}<text wx:if="{{groupIndex === 0 && phaseLabel}}" class="tools-recommended">当前阶段常用</text></view>
    <view class="tab-list">
      <navigator wx:for="{{group.items}}" wx:key="url" class="tab-row motion-press" url="{{item.url}}" hover-class="pressed">
        <view class="icon-tile icon-{{item.tone}}" aria-hidden="true"><image src="/assets/icons/{{item.icon}}.png" mode="aspectFit" /></view>
        <view class="tab-row-copy">
          <view class="tab-row-title">{{item.title}}</view>
          <view class="tab-row-caption">{{item.caption}}</view>
        </view>
        <text class="tab-chevron" aria-hidden="true">›</text>
      </navigator>
    </view>
  </block>
  <view class="section-heading">找医生与交流参考</view>
  <view class="tab-list">
    <navigator class="tab-row" url="{{doctorChannelsUrl}}" hover-class="pressed">
      <view class="icon-tile icon-blue" aria-hidden="true"><image src="/assets/icons/stethoscope.png" mode="aspectFit" /></view>
      <view class="tab-row-copy">
        <view class="tab-row-title">找医生与门诊</view>
        <view class="tab-row-caption">产前诊断、医院小儿骨科和好大夫在线</view>
      </view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
    <navigator class="tab-row" url="{{socialChannelsUrl}}" hover-class="pressed">
      <view class="icon-tile icon-rose" aria-hidden="true"><image src="/assets/icons/messages-square.png" mode="aspectFit" /></view>
      <view class="tab-row-copy">
        <view class="tab-row-title">科普与家长经验</view>
        <view class="tab-row-caption">小红书、抖音搜索词和可核对的科普账号</view>
      </view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
  </view>
</view>
