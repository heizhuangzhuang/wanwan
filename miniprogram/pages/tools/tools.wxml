<view class="container tab-page">
  <view class="tools-heading"><view class="page-heading">家庭工具</view></view>
  <navigator class="tab-feature tools-brace motion-press" url="/pages/brace-wear/brace-wear"
    hover-class="pressed" hover-start-time="0" hover-stay-time="90">
    <view class="icon-tile" aria-hidden="true"><image src="/assets/icons/footprints.png" mode="aspectFit" /></view>
    <view class="tab-row-copy">
      <view class="tab-feature-title">矫正鞋穿戴记录</view>
      <view class="tab-feature-description">穿上开始计时，脱下保存，查看每日累计。</view>
    </view>
    <text class="tab-chevron" aria-hidden="true">›</text>
  </navigator>
  <navigator class="tools-follow-tab motion-press" url="/pages/brace-dashboard/brace-dashboard" hover-class="pressed">
    <image src="/assets/icons/calendar-days.png" mode="aspectFit" aria-hidden="true" />
    <text>穿戴趋势与复诊</text><text class="tools-follow-arrow" aria-hidden="true">›</text>
  </navigator>
  <navigator class="tab-feature tools-cast motion-press" url="/pages/cast/cast"
    hover-class="pressed" hover-start-time="0" hover-stay-time="90">
    <view class="icon-tile" aria-hidden="true"><image src="/assets/icons/calendar-clock.png" mode="aspectFit" /></view>
    <view class="tab-row-copy">
      <view class="tab-feature-title">石膏记录与复诊提醒</view>
      <view class="tab-feature-description">记下石膏日期、医院交代和下次复诊。</view>
    </view>
    <text class="tab-chevron" aria-hidden="true">›</text>
  </navigator>
  <view class="section-heading">就诊准备</view>
  <view class="tab-list">
    <navigator class="tab-row" url="/pages/preparation/preparation" hover-class="pressed">
      <view class="icon-tile icon-sage" aria-hidden="true"><image src="/assets/icons/clipboard-list.png" mode="aspectFit" /></view>
      <view class="tab-row-copy">
        <view class="tab-row-title">就诊沟通清单</view>
        <view class="tab-row-caption">勾选想问的问题，复制到备忘录</view>
      </view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
    <navigator class="tab-row" url="/pages/downloads/downloads" hover-class="pressed">
      <view class="icon-tile icon-gold" aria-hidden="true"><image src="/assets/icons/file-down.png" mode="aspectFit" /></view>
      <view class="tab-row-copy">
        <view class="tab-row-title">足内翻超声复查清单</view>
        <view class="tab-row-caption">下载并打印一页 PDF</view>
      </view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
  </view>
  <view class="section-heading">找医生与交流参考</view>
  <view class="tab-list">
    <navigator class="tab-row" url="{{doctorChannelsUrl}}" hover-class="pressed">
      <view class="icon-tile icon-blue" aria-hidden="true"><image src="/assets/icons/stethoscope.png" mode="aspectFit" /></view>
      <view class="tab-row-copy">
        <view class="tab-row-title">找医生与门诊</view>
        <view class="tab-row-caption">产前诊断、医院小儿骨科和好大夫在线</view>
      </view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
    <navigator class="tab-row" url="{{socialChannelsUrl}}" hover-class="pressed">
      <view class="icon-tile icon-rose" aria-hidden="true"><image src="/assets/icons/messages-square.png" mode="aspectFit" /></view>
      <view class="tab-row-copy">
        <view class="tab-row-title">科普与家长经验</view>
        <view class="tab-row-caption">小红书、抖音搜索词和可核对的科普账号</view>
      </view>
      <text class="tab-chevron" aria-hidden="true">›</text>
    </navigator>
  </view>
</view>
