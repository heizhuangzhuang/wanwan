.feedback-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 10rpx 0 27rpx;
}

.feedback-message {
  width: 100%;
  height: 235rpx;
  line-height: 1.55;
  margin: 10rpx 0 8rpx;
}

.feedback-hint { display: flex; justify-content: space-between; gap: 12rpx; }
.feedback-hint text:last-child { flex: none; }
.feedback-submit { margin-top: 26rpx; }
