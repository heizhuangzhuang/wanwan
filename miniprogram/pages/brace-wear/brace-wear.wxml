<page-meta page-style="{{form || targetOpen ? 'overflow: hidden;' : ''}}" />
<view class="container wear-page {{ready && message && !form && !targetOpen ? 'wear-page-with-message' : ''}}">
  <block wx:if="{{ready}}">
    <view class="wear-summary">
      <view class="wear-summary-top">
        <view>
          <view class="wear-heading">今日穿戴</view>
          <text class="wear-summary-date">{{todayLabel}}</text>
        </view>
        <view class="wear-state {{active ? 'wear-state-running' : ''}}" aria-live="polite">
          <view class="wear-state-dot" aria-hidden="true" />
          <text>{{active ? '计时中' : '未计时'}}</text>
        </view>
      </view>
      <view class="wear-metrics">
        <view class="wear-total" aria-label="{{hasToday ? '今日累计 ' + elapsed : '今天还没记录'}}">
          <view wx:if="{{hasToday}}" class="wear-total-label">累计穿戴</view>
          <view wx:else class="wear-no-record">今天还没记录</view>
          <view wx:if="{{hasToday}}" class="wear-figures">
            <block wx:if="{{subMinute}}">
              <text class="wear-unit">不足</text><text class="wear-number">1</text><text class="wear-unit">分钟</text>
            </block>
            <block wx:else>
              <view class="wear-quantity"><text class="wear-number">{{hours}}</text><text class="wear-unit">小时</text></view>
              <view class="wear-quantity"><text class="wear-number">{{minutes}}</text><text class="wear-unit">分</text></view>
            </block>
          </view>
        </view>
        <button class="wear-button wear-goal" bindtap="openTarget" hover-class="wear-pressed"
          aria-label="{{target ? '调整每日目标，当前 ' + target : '设置每日穿戴目标'}}">
          <view class="wear-goal-ring {{target ? '' : 'wear-goal-empty'}}" style="--wear-goal-progress: {{targetPercent}}%;" aria-hidden="true">
            <view class="wear-goal-center">
              <text wx:if="{{target}}">{{targetCompletion}}%</text>
              <view wx:else class="wear-plus" />
            </view>
          </view>
          <text>{{target ? '目标 ' + target : '设定目标'}}</text>
        </button>
      </view>
      <view wx:if="{{active}}" class="wear-started">
        <text>本次 {{activeElapsed}}</text><text>{{startedAt}} 开始</text>
      </view>
    </view>

    <view class="wear-history">
      <view class="wear-section-header">
        <view class="wear-section-title">最近 7 天</view>
        <picker class="wear-date-picker" mode="date" value="{{selectedDay}}" end="{{today}}" bindchange="pickDay" aria-label="选择历史日期">
          <view class="wear-date-button">
            <image src="/assets/icons/calendar-days.png" mode="aspectFit" aria-hidden="true" />
            <text>选日期</text>
          </view>
        </picker>
      </view>
      <view class="wear-chart">
        <view class="wear-axis" aria-hidden="true">
          <text>24时</text><text>12时</text><text>0时</text>
        </view>
        <view class="wear-plot">
          <view class="wear-guides" aria-hidden="true"><view /><view /><view /></view>
          <view class="wear-columns">
            <button wx:for="{{week}}" wx:key="day"
              class="wear-button wear-day {{selectedDay === item.day ? 'wear-day-selected' : ''}}"
              data-day="{{item.day}}" bindtap="chooseDay" aria-pressed="{{selectedDay === item.day}}"
              aria-label="{{item.day}}，{{item.total}}" hover-class="wear-pressed">
              <view class="wear-column-slot" aria-hidden="true">
                <view wx:if="{{item.height > 0}}" class="wear-column-fill" style="height: {{item.height}}%;" />
                <view wx:else class="wear-column-empty" />
              </view>
              <text class="wear-weekday">{{item.weekday}}</text>
              <text class="wear-column-date">{{item.date}}</text>
            </button>
          </view>
        </view>
      </view>

      <view class="wear-detail">
        <view class="wear-section-header">
          <view>
            <view class="wear-detail-title">{{selectedLabel}}明细</view>
            <view wx:if="{{hasDetails}}" class="wear-detail-total">合计 {{selectedElapsed}}</view>
          </view>

        </view>
        <block wx:if="{{hasDetails}}">
          <view wx:if="{{includesActive}}" class="wear-session wear-session-active">
            <view class="wear-timeline-dot" aria-hidden="true" />
            <text>含正在计时的一段</text>
          </view>
          <view wx:for="{{sessions}}" wx:key="id" class="wear-session">
            <view class="wear-timeline-dot" aria-hidden="true" />
            <text class="wear-session-time">{{item.label}}</text>
            <button class="wear-button wear-link" data-id="{{item.id}}" bindtap="editSession"
              aria-label="编辑 {{item.label}}" hover-class="wear-pressed">编辑</button>
          </view>
        </block>
        <view wx:else class="wear-empty">{{selectedZero ? '已确认未穿' : '这天还没有穿戴记录'}}</view>
      </view>
    </view>

    <navigator url="/pages/brace-dashboard/brace-dashboard" class="wear-dashboard-link" hover-class="wear-pressed">
      <view class="wear-trend-icon" aria-hidden="true"><view /><view /><view /></view>
      <view class="wear-dashboard-text"><view>穿戴趋势与复诊</view><text>穿戴趋势、计划历史与 Excel 导出</text></view>
      <text class="wear-chevron" aria-hidden="true">›</text>
    </navigator>
    <view class="wear-secondary-links">
      <navigator url="/pages/followup/followup?observe=1&day={{selectedDay}}">记录穿戴困难 ›</navigator>
      <navigator url="/pages/brace-sync/brace-sync">档案同步 ›</navigator>
    </view>

    <view wx:if="{{!form && !targetOpen}}" class="wear-dock">
      <view wx:if="{{message}}" class="wear-message wear-dock-message" aria-live="polite">{{message}}</view>
      <view class="wear-primary-actions">
        <button class="wear-button wear-toggle {{active ? 'wear-toggle-running' : ''}}" bindtap="toggleWear"
          hover-class="wear-pressed" hover-start-time="0" hover-stay-time="100">
          <view class="{{active ? 'wear-stop' : 'wear-play'}}" aria-hidden="true" />
          <text>{{active ? '脱下并保存' : '穿上，开始计时'}}</text>
        </button>
        <button class="wear-button wear-add" bindtap="addSession" aria-label="补记{{selectedLabel}}穿戴时间"
          hover-class="wear-pressed" hover-start-time="0" hover-stay-time="100">
          <view class="wear-plus" aria-hidden="true" />
          <text>补记{{selectedDay === today ? '今天' : selectedLabel}}</text>
        </button>
      </view>
    </view>
  </block>
  <view wx:elif="{{message}}" class="wear-message" aria-live="polite">{{message}}</view>

  <view wx:if="{{form || targetOpen}}" class="wear-overlay">
    <view wx:if="{{form}}" class="wear-scrim" bindtap="closeForm" aria-hidden="true" />
    <view wx:else class="wear-scrim" bindtap="closeTarget" aria-hidden="true" />
    <view class="wear-sheet" aria-role="dialog">
      <block wx:if="{{form}}">
        <view class="wear-sheet-header">
          <view class="wear-sheet-title">{{form.id ? '编辑穿戴记录' : '补记穿戴时间'}}</view>
          <button wx:if="{{form.id}}" class="wear-button wear-delete" data-id="{{form.id}}" bindtap="removeSession"
            hover-class="wear-pressed">删除</button>
        </view>

        <view class="wear-form-row">
          <text class="wear-field-label">穿上</text>
          <picker mode="date" value="{{form.startDay}}" end="{{today}}" data-field="startDay" bindchange="changeTime">
            <view class="wear-field">{{form.startDay}}</view>
          </picker>
          <picker mode="time" value="{{form.startTime || '08:00'}}" data-field="startTime" bindchange="changeTime">
            <view class="wear-field {{form.startTime ? '' : 'wear-placeholder'}}">{{form.startTime || '选时间'}}</view>
          </picker>
        </view>
        <view class="wear-form-row">
          <text class="wear-field-label">脱下</text>
          <picker mode="date" value="{{form.endDay}}" start="{{form.startDay}}" end="{{today}}" data-field="endDay" bindchange="changeTime">
            <view class="wear-field">{{form.endDay}}</view>
          </picker>
          <picker mode="time" value="{{form.endTime || '20:00'}}" data-field="endTime" bindchange="changeTime">
            <view class="wear-field {{form.endTime ? '' : 'wear-placeholder'}}">{{form.endTime || '选时间'}}</view>
          </picker>
        </view>
        <view class="wear-hint">隔天脱下时，选择实际的脱下日期。</view>
        <view wx:if="{{message}}" class="wear-message" aria-live="polite">{{message}}</view>
        <view class="wear-sheet-actions">
          <button class="wear-button wear-secondary" bindtap="closeForm" hover-class="wear-pressed">取消</button>
          <button class="wear-button wear-confirm" bindtap="saveSession" hover-class="wear-pressed">保存记录</button>
        </view>
      </block>
      <block wx:else>
        <view class="wear-sheet-header">
          <view class="wear-sheet-title">每日穿戴目标</view>
          <button wx:if="{{target}}" class="wear-button wear-delete" bindtap="clearTarget" hover-class="wear-pressed">清除</button>
        </view>
        <view class="wear-hint">填写医生交代的每日穿戴时长。</view>
        <view class="wear-target-inputs">
          <view class="wear-target-field">
            <input type="number" value="{{targetHours}}" placeholder="0" maxlength="2" aria-label="小时" bindinput="changeHours" />
            <text>小时</text>
          </view>
          <view class="wear-target-field">
            <input type="number" value="{{targetMinutes}}" placeholder="0" maxlength="2" aria-label="分钟" bindinput="changeMinutes" />
            <text>分钟</text>
          </view>
        </view>
        <view wx:if="{{message}}" class="wear-message" aria-live="polite">{{message}}</view>
        <view class="wear-sheet-actions">
          <button class="wear-button wear-secondary" bindtap="closeTarget" hover-class="wear-pressed">取消</button>
          <button class="wear-button wear-confirm" bindtap="saveTarget" hover-class="wear-pressed">保存目标</button>
        </view>
      </block>
    </view>
  </view>
</view>
