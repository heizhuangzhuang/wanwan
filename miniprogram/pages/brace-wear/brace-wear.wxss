page { background: #f9f8fc; }

.wear-page {
  --wear-bg: #f9f8fc;
  --wear-ink: #23213a;
  --wear-muted: #625e76;
  --wear-line: #e5e1ee;
  --wear-paper: #fff;
  --wear-primary: #433197;
  --wear-tint: #ede8fb;
  --wear-chart-height: 128rpx;
  max-width: 520px;
  padding: 18rpx 24rpx 164rpx;
  padding-bottom: calc(164rpx + env(safe-area-inset-bottom));
  color: var(--wear-ink);
  line-height: 1.4;
}

.wear-page-with-message { padding-bottom: 238rpx; padding-bottom: calc(238rpx + env(safe-area-inset-bottom)); }

.wear-page .wear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  max-width: none;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: 1.25;
  transition: opacity 130ms ease-out, transform 130ms ease-out;
}

.wear-button::after { border: 0; }
.wear-pressed { opacity: .78; }
.wear-button.wear-pressed { transform: scale(.98); }

.wear-summary {
  padding: 27rpx 30rpx 25rpx;
  border-radius: 38rpx;
  border: 1rpx solid #e5dcf7;
  background: #f1ebfb;
}

.wear-summary-top, .wear-section-header, .wear-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.wear-heading { font-size: 39rpx; font-weight: 700; line-height: 1.2; }
.wear-summary-date { display: block; margin-top: 6rpx; color: var(--wear-muted); font-size: 26rpx; }

.wear-state {
  display: flex;
  flex: none;
  align-items: center;
  gap: 9rpx;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  background: #fbf8ff;
  color: #615772;
  font-weight: 600;
  font-size: 24rpx;
}

.wear-state-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #8e829e; }
.wear-state-running { color: #254b43; background: #dbeee7; }
.wear-state-running .wear-state-dot { background: #34785e; }

.wear-metrics { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; margin-top: 26rpx; }
.wear-total { min-width: 0; padding-bottom: 6rpx; }
.wear-total-label { color: var(--wear-muted); font-size: 26rpx; }
.wear-figures { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 15rpx; margin-top: 4rpx; }
.wear-quantity { display: flex; align-items: baseline; gap: 5rpx; }
.wear-number {
  font-family: "DIN Alternate", "Avenir Next", "Roboto", sans-serif;
  font-size: 81rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: .98;
  font-variant-numeric: tabular-nums;
}
.wear-unit { font-size: 26rpx; font-weight: 500; color: var(--wear-muted); white-space: nowrap; }

.wear-page .wear-goal {
  flex: none;
  flex-direction: column;
  width: min(224rpx, 42%);
  min-height: 96rpx;
  gap: 8rpx;
  padding: 0 4rpx;
  color: var(--wear-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.wear-goal-ring {
  --wear-goal-track: #ddd4f0;
  display: grid;
  place-items: center;
  width: 83rpx;
  height: 83rpx;
  border-radius: 50%;
  background: var(--wear-goal-track);
  background: conic-gradient(#6650bd var(--wear-goal-progress), var(--wear-goal-track) 0);
}
.wear-goal-empty { border: 2rpx dashed #9683ce; background: none; box-sizing: border-box; }
.wear-goal-center {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 69rpx;
  height: 69rpx;
  border-radius: 50%;
  background: #f1ebfb;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.wear-started {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 4rpx 14rpx;
  margin-top: 22rpx;
  border-top: 1rpx solid #ded4ef;
  padding-top: 14rpx;
  color: #514368;
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.wear-history {
  margin-top: 24rpx;
  padding: 6rpx 14rpx 18rpx;
  border: 1rpx solid var(--wear-line);
  border-radius: 30rpx;
  background: var(--wear-paper);
}
.wear-history > .wear-section-header { padding: 0 10rpx; }
.wear-section-title { font-weight: 700; font-size: 33rpx; }
.wear-date-picker { flex: none; }
.wear-date-button {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-height: 88rpx;
  padding-left: 12rpx;
  color: var(--wear-primary);
  font-size: 25rpx;
  font-weight: 650;
}
.wear-date-button image { width: 29rpx; height: 29rpx; filter: grayscale(1); }

.wear-chart { position: relative; padding-top: 15rpx; }
.wear-axis {
  position: absolute;
  top: 1rpx;
  left: 10rpx;
  width: calc(100% - 18rpx);
  height: calc(var(--wear-chart-height) + 26rpx);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  color: var(--wear-muted);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  pointer-events: none;
}
.wear-axis text {
  z-index: 1;
  padding-right: 4rpx;
  background: var(--wear-paper);
}
.wear-plot { position: relative; }
.wear-guides {
  position: absolute;
  top: 0;
  right: 2rpx;
  left: 54rpx;
  height: var(--wear-chart-height);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  pointer-events: none;
}
.wear-guides view { border-top: 1rpx dashed #e5dfef; }

.wear-columns { display: flex; position: relative; padding-left: 47rpx; }
.wear-page .wear-day {
  flex: 1;
  width: 0;
  flex-direction: column;
  align-items: stretch;
  padding: 0 0 6rpx;
  border-radius: 16rpx;
}
.wear-column-slot {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: var(--wear-chart-height);
}
.wear-column-fill {
  width: 41%;
  min-height: 4rpx;
  border-radius: 7rpx 7rpx 3rpx 3rpx;
  background: #a995dd;
  transition: height 180ms ease-out, background-color 130ms ease-out;
}
.wear-column-empty { width: 16rpx; height: 4rpx; border-radius: 3rpx; background: #c9c1d9; }
.wear-day-selected .wear-column-fill, .wear-day-selected .wear-column-empty { background: #654cbd; }
.wear-weekday, .wear-column-date { display: block; text-align: center; color: var(--wear-muted); white-space: nowrap; }
.wear-weekday { margin-top: 10rpx; font-size: 23rpx; line-height: 1.4; }
.wear-column-date { font-size: 21rpx; font-variant-numeric: tabular-nums; }
.wear-page .wear-day-selected { background: #f2edfc; }
.wear-day-selected .wear-weekday, .wear-day-selected .wear-column-date { color: var(--wear-primary); font-weight: 700; }

.wear-detail { margin: 18rpx 10rpx 0; border-top: 1rpx solid var(--wear-line); padding-top: 4rpx; }
.wear-detail-title { font-size: 30rpx; font-weight: 700; }
.wear-detail-total { margin-top: 5rpx; color: var(--wear-muted); font-size: 24rpx; }
.wear-page .wear-link {
  flex: none;
  width: auto;
  min-height: 88rpx;
  padding: 0 0 0 14rpx;
  color: var(--wear-primary);
  font-size: 25rpx;
  font-weight: 650;
}
.wear-empty { padding: 0 0 6rpx; color: var(--wear-muted); font-size: 26rpx; }
.wear-session {
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 13rpx;
  border-top: 1rpx solid var(--wear-line);
  font-size: 26rpx;
}
.wear-timeline-dot { width: 12rpx; height: 12rpx; flex: none; border-radius: 50%; background: #917acb; }
.wear-session-time { flex: 1; min-width: 0; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.wear-session-active { color: #254b43; }
.wear-session-active .wear-timeline-dot { background: #34785e; }

.wear-dashboard-link {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 115rpx;
  margin-top: 18rpx;
  padding: 11rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--wear-line);
  border-radius: 23rpx;
  background: #fff;
  color: var(--wear-ink);
}
.wear-trend-icon { flex: none; display: flex; align-items: flex-end; justify-content: center; gap: 4rpx; width: 56rpx; height: 56rpx; padding-bottom: 13rpx; border-radius: 16rpx; background: var(--wear-tint); box-sizing: border-box; }
.wear-trend-icon view { width: 5rpx; height: 11rpx; border-radius: 2rpx; background: var(--wear-primary); }
.wear-trend-icon view:nth-child(2) { height: 20rpx; }
.wear-trend-icon view:nth-child(3) { height: 28rpx; }
.wear-dashboard-text { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 650; }
.wear-dashboard-text text { display: block; color: var(--wear-muted); font-size: 24rpx; font-weight: 400; }
.wear-chevron { color: var(--wear-primary); font-size: 44rpx; line-height: 1; }
.wear-foot { margin-top: 18rpx; color: var(--wear-muted); font-size: 23rpx; text-align: center; }

.wear-dock {
  position: fixed;
  z-index: 5;
  bottom: 0;
  left: 50%;
  width: 100%;
  max-width: 520px;
  box-sizing: border-box;
  padding: 14rpx 24rpx 15rpx;
  padding-bottom: calc(15rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  border-top: 1rpx solid var(--wear-line);
  background: var(--wear-bg);
}
.wear-primary-actions { display: flex; gap: 14rpx; }
.wear-page .wear-toggle, .wear-page .wear-add {
  width: auto;
  min-height: 96rpx;
  gap: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.wear-page .wear-toggle { flex: 1; background: var(--wear-primary); color: #fff; }
.wear-page .wear-toggle-running { background: #254b43; }
.wear-page .wear-add { flex: 0 0 32%; border: 1rpx solid #d7cdef; background: var(--wear-tint); color: var(--wear-primary); }
.wear-play { border-left: 17rpx solid currentColor; border-top: 11rpx solid transparent; border-bottom: 11rpx solid transparent; width: 0; height: 0; flex: none; }
.wear-stop { width: 20rpx; height: 20rpx; border-radius: 4rpx; background: currentColor; flex: none; }
.wear-plus { width: 24rpx; height: 24rpx; position: relative; flex: none; }
.wear-plus::before, .wear-plus::after { content: ""; position: absolute; inset: 50% auto auto 50%; width: 22rpx; height: 3rpx; transform: translate(-50%, -50%); background: currentColor; border-radius: 5rpx; }
.wear-plus::after { transform: translate(-50%, -50%) rotate(90deg); }

.wear-overlay { position: fixed; inset: 0; z-index: 10; }
.wear-scrim { position: absolute; inset: 0; background: rgba(26, 20, 44, .5); }
.wear-sheet {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 100%;
  max-width: 520px;
  max-height: 78vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 28rpx 27rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--wear-paper);
  transform: translateX(-50%);
  animation: wear-sheet-in 200ms ease-out;
}
@keyframes wear-sheet-in {
  from { opacity: .7; transform: translate(-50%, 24rpx); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

.wear-sheet-header { min-height: 70rpx; margin-bottom: 12rpx; }
.wear-sheet-title { font-size: 37rpx; font-weight: 700; line-height: 1.25; }
.wear-page .wear-delete { width: auto; min-height: 88rpx; padding: 0 14rpx; color: #9a3049; font-size: 26rpx; }
.wear-form-row {
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1.35fr) minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  margin: 14rpx 0;
}
.wear-field-label { font-size: 27rpx; font-weight: 650; }
.wear-field, .wear-target-field {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--wear-line);
  border-radius: 17rpx;
  background: var(--wear-bg);
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.wear-placeholder, .wear-hint { color: var(--wear-muted); }
.wear-hint { margin: 11rpx 0 14rpx; font-size: 25rpx; }
.wear-target-inputs { display: flex; gap: 13rpx; margin: 20rpx 0; }
.wear-target-field { flex: 1; min-width: 0; }
.wear-target-field input { width: 104rpx; min-height: 88rpx; text-align: center; font-size: 32rpx; }

.wear-sheet-actions { display: flex; gap: 13rpx; margin-top: 24rpx; }
.wear-page .wear-sheet-actions .wear-button {
  width: auto;
  min-height: 94rpx;
  padding: 0 12rpx;
  border-radius: 21rpx;
  font-size: 29rpx;
  font-weight: 650;
}
.wear-page .wear-secondary { flex: 1; color: var(--wear-primary); background: var(--wear-tint); }
.wear-page .wear-confirm { flex: 1.6; color: #fff; background: var(--wear-primary); }
.wear-message {
  padding: 12rpx 17rpx;
  margin: 13rpx 0 0;
  border: 1rpx solid #e1d7f2;
  border-radius: 14rpx;
  background: #f5effc;
  color: #493962;
  font-size: 26rpx;
}
.wear-dock-message { margin: 0 0 12rpx; }

@media (max-width: 340px) {
  .wear-number { font-size: 72rpx; }
  .wear-figures { column-gap: 11rpx; }
  .wear-page .wear-add { gap: 7rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .wear-page .wear-button, .wear-column-fill { transition: none; }
  .wear-button.wear-pressed { transform: none; }
  .wear-sheet { animation: none; }
}
