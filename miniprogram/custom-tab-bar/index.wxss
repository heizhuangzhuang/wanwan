.tab-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  background: #fffdf9;
  border-top: 1rpx solid #ded9ce;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-dock-inner { display: flex; max-width: 840rpx; margin: 0 auto; padding: 0 12rpx; }
.tab-dock-item { flex: 1; padding: 18rpx 8rpx; }
.tab-dock-label {
  background: #fffdf9;
  color: #555c51;
  text-align: center;
  border-radius: 22rpx;
  font-size: 26rpx;
  height: 58rpx;
  line-height: 58rpx;
}

.tab-dock-active .tab-dock-label { background: #e5eee3; color: #285143; font-weight: 700; }
