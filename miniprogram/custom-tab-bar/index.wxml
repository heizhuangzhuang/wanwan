<cover-view class="tab-dock">
  <cover-view class="tab-dock-inner">
    <cover-view wx:for="{{tabs}}" wx:key="path" data-path="{{item.path}}" bindtap="switchSection" aria-role="button"
      aria-label="{{item.label}}{{active === item.path ? '，当前栏目' : ''}}"
      class="tab-dock-item {{active === item.path ? 'tab-dock-active' : ''}}">
      <cover-view class="tab-dock-label">{{item.label}}</cover-view>
    </cover-view>
  </cover-view>
</cover-view>
