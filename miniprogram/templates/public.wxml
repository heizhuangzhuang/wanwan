<template name="resourceCards">
  <button wx:for="{{items}}" wx:key="name" class="card resource-card motion-press" data-name="{{item.name}}" bindtap="openDetail"
    hover-class="pressed" hover-start-time="0" hover-stay-time="90">
    <view class="title">{{item.title}}</view>
    <view class="description">{{item.intro}}</view>
    <view class="resource-meta"><text>{{item.materialLabel}}</text><text>{{item.sourceName}}</text></view>
    <view wx:if="{{item.accessLabel}}" class="muted">{{item.accessLabel}}</view>
  </button>
</template>

<template name="pagination">
  <view wx:if="{{page > 1 || hasNext}}" class="pagination">
    <button class="btn secondary" disabled="{{loading || page <= 1}}" bindtap="previousPage">上一页</button>
    <text class="muted">第 {{page}} 页</text>
    <button class="btn secondary" disabled="{{loading || !hasNext}}" bindtap="nextPage">下一页</button>
  </view>
</template>
